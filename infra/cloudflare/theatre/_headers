# Cloudflare Pages delivery policy for Cantos theatre Web (reviewed in Git; validated by
# `cargo xtask deploy cloudflare`). Pages MERGES every matching rule instead of letting a later
# one win, so the rules below are disjoint on Cache-Control: no rule here sets it for assets.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/
  Cache-Control: no-cache, no-store
/index.html
  Cache-Control: no-cache, no-store
# ADR 0048: Pages serves the byte-identical `verify-email.html` at the signup email action path.
/verify-email
  Cache-Control: no-cache, no-store
/verify-email.html
  Cache-Control: no-cache, no-store
