# Private bridge for the Cantos production containers. Only cantos-edge publishes ports.
# PostgreSQL is not on this network at all (Unix socket only).
[Unit]
Description=Cantos private container network

[Network]
NetworkName=cantos
# A stable bridge name lets the host firewall route exactly this network (cantos-vps bootstrap).
PodmanArgs=--interface-name=cantos0
Label=io.cantos.owner=cantos-vps
