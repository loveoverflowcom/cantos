#!/usr/bin/env bash
# cantos-vps: root-owned automation on the Cantos production VPS (ADR 0039).
#
# Installed at /usr/local/sbin/cantos-vps by `cantos-vps install`, which `cargo xtask deploy vps`
# runs from an uploaded bundle. Every command is explicit; nothing here runs on a schedule except
# `backup scheduled` (cantos-backup.timer). Secrets are generated on the host, stored root-only
# and handed to containers as Podman secrets; none is printed, logged or passed as an argument.
#
#   install TREE_DIR          install Quadlet units, edge/Kanidm/SQL policy and this script
#   bootstrap                 idempotent host setup: dirs, secrets, private CA, roles, base services
#   reload-browser            validate installed browser policy and restart edge/API only
#   deploy REVISION           backup, migrate, grant, switch the API image, health-gate, auto-rollback
#   rollback                  switch the API back to the previous image and health-gate it
#   backup [LABEL]            pg_dump (custom format) with checksum and retention
#   restore FILE --yes-replace-database
#                             replace the cantos database from a backup (APIs stopped meanwhile)
#   status                    units, health, revisions and recent backups
#   identity --studio-admin NAME [--display TEXT] [--listener NAME]
#                             OPERATOR-RUN: Kanidm OAuth2 clients, groups and people; prints
#                             one-time credential reset links to the operator's own terminal
set -Eeuo pipefail
umask 077

readonly ROOT=${CANTOS_VPS_ROOT:-/root/cantos-services}
readonly RUNTIME=$ROOT/runtime
readonly CONFIG=$ROOT/config
readonly STATE=$ROOT/state
readonly SECRETS=$ROOT/secrets
readonly BACKUPS=$ROOT/backups
readonly KANIDM_DIR=$ROOT/kanidm
readonly EDGE_DIR=$ROOT/edge
readonly CA_DIR=$ROOT/internal-ca
readonly QUADLET_DIR=/etc/containers/systemd
readonly SYSTEMD_DIR=/etc/systemd/system
readonly IMAGE_REPO=localhost/cantos-api
readonly KANIDM_TOOLS=docker.io/kanidm/tools:1.10.5
readonly LOCK=/run/lock/cantos-vps.lock
readonly BACKUP_KEEP=${CANTOS_BACKUP_KEEP:-14}
readonly API_UNITS=(cantos-api-theatre cantos-api-studio)
readonly SOCKET_URL_SUFFIX='@/cantos?host=/run/postgresql'
readonly SCHEMA_EPOCH=2
CANTOS_VPS_LOCK_OWNER=

log() { printf '[cantos-vps] %s\n' "$*" >&2; }
die() {
  log "ERROR: $1"
  exit "${2:-1}"
}

require_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || die "run as root" 77; }

with_lock() {
  # Internal install/recovery shares the caller's lock; reopening fd 9 would briefly
  # release it and permit another operator between the two cutover phases.
  [[ $CANTOS_VPS_LOCK_OWNER != "$BASHPID" ]] || return 0
  exec 9>"$LOCK"
  flock -n 9 || die "another cantos-vps operation holds $LOCK" 75
  CANTOS_VPS_LOCK_OWNER=$BASHPID
  # A shell may have passed main's guard before preparation acquired/released the
  # lock. Recheck under the lock so that stale process cannot mutate a prepared host.
  if [[ ${1:-ordinary} != cutover && -s $STATE/epoch2-cutover.pending ]]; then
    die 'epoch2 cutover pending; ordinary mutations are refused under the operation lock' 75
  fi
}

# KEY=VALUE reader that never sources the file (values stay inert).
config_value() {
  local file=$1 key=$2
  awk -v key="$key" -F= '
    /^[[:space:]]*(#|$)/ { next }
    $1 == key { sub(/^[^=]*=/, ""); value = $0; count++ }
    END { if (count == 1) print value; else exit 1 }
  ' "$file"
}

edge_value() {
  local value
  value=$(config_value "$CONFIG/edge.env" "$1") || die "$CONFIG/edge.env must define $1 exactly once" 66
  [[ -n $value && $value != REPLACE_WITH_* ]] || die "$CONFIG/edge.env: set $1" 66
  [[ $value =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || die "$1 must be a lowercase DNS name" 65
  printf '%s\n' "$value"
}

# Browser inputs are explicit deployment policy, independent of transitional Web proxy hosts.
deployment_value() {
  local value key=$1
  value=$(config_value "$CONFIG/edge.env" "$key") || die "$CONFIG/edge.env must define $key exactly once" 66
  [[ -n $value && $value != REPLACE_WITH_* ]] || die "$CONFIG/edge.env: set $key" 66
  printf '%s\n' "$value"
}

browser_origin() {
  local key=CANTOS_${1^^}_${2}_ORIGIN value last_label
  value=$(deployment_value "$key") || return $?
  # Public ingress uses default HTTPS on lowercase DNS names. Refuse normalization, ports,
  # credentials, paths, queries and fragments instead of changing the operator's input.
  [[ $value =~ ^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ &&
    ${#value} -le 261 ]] || die "$key must be an exact HTTPS origin with a lowercase DNS name and no port" 65
  # WHATWG URL parsers interpret a numeric final label as IPv4, including shorthand/hex.
  # The deployment boundary accepts DNS names only; never normalize those inputs silently.
  last_label=${value##*.}
  [[ ! $last_label =~ ^([0-9]+|0x[0-9a-f]*)$ ]] ||
    die "$key must be an exact HTTPS origin with a lowercase DNS name and no numeric final label" 65
  printf '%s\n' "$value"
}

validate_browser_configuration() {
  local api surface web api_origin callback key theatre_web=""
  api=$(edge_value CANTOS_API_HOST) || return $?
  if [[ -n $(config_value "$CONFIG/edge.env" CANTOS_API_ALIAS_HOST 2>/dev/null) ]]; then
    local alias
    alias=$(edge_value CANTOS_API_ALIAS_HOST) || return $?
    [[ $alias != "$api" ]] || die 'API alias must differ from the primary API host' 65
  elif grep -q '^CANTOS_API_ALIAS_HOST=' "$CONFIG/edge.env"; then
    die 'API alias must be defined exactly once and nonempty, or omitted' 65
  fi
  for surface in theatre studio; do
    web=$(browser_origin "$surface" WEB) || return $?
    api_origin=$(browser_origin "$surface" API) || return $?
    [[ $api_origin == "https://$api" ]] || die "CANTOS_${surface^^}_API_ORIGIN must match CANTOS_API_HOST (https://$api)" 65
    key=CANTOS_${surface^^}_OIDC_CALLBACK
    callback=$(deployment_value "$key") || return $?
    [[ $callback == "$api_origin/api/v1/$surface/auth/callback" ]] ||
      die "$key must equal $api_origin/api/v1/$surface/auth/callback" 65
    if [[ $surface == theatre ]]; then
      theatre_web=$web
    else
      [[ $web != "$theatre_web" ]] || die "Theatre and Studio must have distinct Web origins" 65
    fi
  done
}

render_api_configuration() {
  local surface web api
  for surface in theatre studio; do
    web=$(browser_origin "$surface" WEB) || return $?
    api=$(browser_origin "$surface" API) || return $?
    printf 'CANTOS_ENV=production\nCANTOS_BIND_ADDRESS=0.0.0.0:8080\nCANTOS_BROWSER_API_SURFACE=%s\nCANTOS_WEB_ORIGIN=%s\nCANTOS_API_ORIGIN=%s\n' \
      "$surface" "$web" "$api" >"$CONFIG/api-$surface.env"
  done
}

require_runtime_value() {
  local file=$1 key=$2 expected=$3 actual remedy=${4:-reconcile configuration with bootstrap before deployment}
  actual=$(config_value "$file" "$key" 2>/dev/null) ||
    die "$file must define $key exactly once; $remedy" 66
  [[ $actual == "$expected" ]] || die "$file has stale $key; $remedy" 65
}

browser_bearer_callback() {
  local surface=$1 api
  case $surface in theatre|studio) ;; *) die 'unknown browser identity surface' 64 ;; esac
  api=$(browser_origin "$surface" API) || return $?
  printf '%s/api/v1/%s/auth/bearer/callback\n' "$api" "$surface"
}

require_oidc_callback_receipt() {
  local surface=$1 callback bearer_callback
  callback=$(deployment_value CANTOS_${surface^^}_OIDC_CALLBACK) || return $?
  bearer_callback=$(browser_bearer_callback "$surface") || return $?
  require_runtime_value "$CONFIG/oidc-callbacks.env" CANTOS_${surface^^}_OIDC_CALLBACK "$callback" \
    "complete separately authorized identity --reconcile-existing before deployment" || return $?
  require_runtime_value "$CONFIG/oidc-callbacks.env" CANTOS_${surface^^}_OIDC_BEARER_CALLBACK "$bearer_callback" \
    "complete separately authorized identity --reconcile-existing for both exact callbacks before deployment"
}

validate_supplemental_environment() {
  local file=$1 surface=$2 line
  [[ -f $file ]] || die "supplemental API EnvironmentFile is missing: $file" 66
  if grep -Eq '^[[:space:]]*(CANTOS_ENV|CANTOS_BIND_ADDRESS|CANTOS_WEB_ORIGIN|CANTOS_API_ORIGIN|CANTOS_BROWSER_API_SURFACE)[[:space:]]*=' "$file"; then
    die "$file overrides protected API browser configuration; keep those keys only in api-$surface.env" 65
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    # Podman may forward the host value for an unassigned name. Only literal assignments
    # are supported here; values stay inert and may contain spaces/JSON for registration.
    [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] ||
      die "$file has an unsupported supplemental API env assignment; use plain KEY=VALUE lines only" 65
  done <"$file"
  if grep -Eq '^[[:space:]]*CANTOS_[A-Z_]*OIDC_ISSUER[[:space:]]*=' "$file"; then
    require_oidc_callback_receipt "$surface"
  fi
}

validate_api_dropins() {
  local surface=$1 file line path key
  for file in "$QUADLET_DIR/cantos-api-$surface.container.d/"*.conf; do
    [[ -e $file ]] || continue
    while IFS= read -r line || [[ -n $line ]]; do
      case $line in
        ''|'#'*|'[Container]'|'[Unit]'|'[Service]') ;;
        Description=*|Requires=*|After=*|Before=*|Wants=*|Restart=*|RestartSec=*|TimeoutStartSec=*|TimeoutStopSec=*|Volume=*|Network=*|NetworkAlias=*|ReadOnly=*|NoNewPrivileges=*|DropCapability=*|HealthCmd=*|HealthInterval=*|HealthStartPeriod=*|HealthRetries=*|Label=*) ;;
        EnvironmentFile=*)
          path=${line#EnvironmentFile=}
          [[ $path =~ ^/[A-Za-z0-9_./-]+$ && $path != "$CONFIG/api-$surface.env" ]] ||
            die "$file has an unsupported API EnvironmentFile; use a simple absolute supplemental env-file path" 65
          validate_supplemental_environment "$path" "$surface"
          ;;
        Environment=*)
          [[ $line =~ ^Environment=([A-Z][A-Z0-9_]*)=([A-Za-z0-9_./:,-]+)$ ]] ||
            die "$file has an unsupported API Environment assignment; use one simple assignment or a supplemental env file" 65
          key=${BASH_REMATCH[1]}
          case $key in
            CANTOS_ENV|CANTOS_BIND_ADDRESS|CANTOS_WEB_ORIGIN|CANTOS_API_ORIGIN|CANTOS_BROWSER_API_SURFACE)
              die "$file overrides protected API browser configuration; keep $key only in api-$surface.env" 65 ;;
            CANTOS_*OIDC_ISSUER)
              require_oidc_callback_receipt "$surface" ;;
          esac
          ;;
        "Secret=cantos-$surface-oidc-secret,type=env,target=CANTOS_${surface^^}_OIDC_SECRET") ;;
        *) die "$file has an unsupported API drop-in directive; reconcile with the supported browser configuration contract" 65 ;;
      esac
    done <"$file"
  done
}

# Deploy/rollback never rewrite running origin policy. A reviewed bootstrap/identity operation
# must reconcile it first, so failed image switches cannot strand a changed browser boundary.
validate_runtime_browser_configuration() {
  validate_browser_configuration
  local surface file
  for surface in theatre studio; do
    file=$CONFIG/api-$surface.env
    require_runtime_value "$file" CANTOS_ENV production
    require_runtime_value "$file" CANTOS_BIND_ADDRESS 0.0.0.0:8080
    require_runtime_value "$file" CANTOS_BROWSER_API_SURFACE "$surface"
    require_runtime_value "$file" CANTOS_WEB_ORIGIN "$(browser_origin "$surface" WEB)"
    require_runtime_value "$file" CANTOS_API_ORIGIN "$(browser_origin "$surface" API)"
    validate_api_dropins "$surface"
    if [[ -f $CONFIG/api-$surface-oidc.env ]]; then
      require_oidc_callback_receipt "$surface"
    fi
  done
}

unit_active() { systemctl is-active --quiet "$1.service"; }

# Apply already reconciled origin/callback files without bootstrap, credentials, SQL,
# migrations or image switching. Notify=healthy keeps API restart failures observable.
reload_browser() {
  local tree=${1:?usage: cantos-vps reload-browser TREE_DIR}
  require_root
  with_lock
  [[ -f $tree/infra/edge/Caddyfile ]] || die 'browser bundle has no Caddyfile' 66
  validate_runtime_browser_configuration
  local unit
  for unit in cantos-edge "${API_UNITS[@]}"; do
    unit_active "$unit" || die "$unit must already be active" 69
  done
  install -m 0644 "$tree/infra/edge/Caddyfile" "$EDGE_DIR/Caddyfile.browser-candidate"
  if ! podman exec --env-file "$CONFIG/edge.env" cantos-edge \
    caddy validate --config /etc/caddy/Caddyfile.browser-candidate --adapter caddyfile >/dev/null; then
    rm -f "$EDGE_DIR/Caddyfile.browser-candidate"
    die 'candidate Caddy configuration refused; running configuration unchanged' 65
  fi
  cp -a "$EDGE_DIR/Caddyfile" "$EDGE_DIR/Caddyfile.before-browser-reload"
  mv "$EDGE_DIR/Caddyfile.browser-candidate" "$EDGE_DIR/Caddyfile"
  for unit in cantos-edge "${API_UNITS[@]}"; do
    systemctl restart "$unit.service" || die "$unit browser configuration restart failed; restore the reviewed configuration snapshot" 71
  done
  log 'browser configuration reloaded; database, credentials and API image unchanged'
}

# ---------------------------------------------------------------------------------- install

install_bundle() {
  local tree=${1:?usage: cantos-vps install TREE_DIR}
  require_root
  with_lock
  # TREE_DIR is an extracted `git archive` subset: REVISION, infra/vps and infra/edge/Caddyfile.
  [[ -f $tree/infra/vps/bin/cantos-vps && -d $tree/infra/vps/quadlet && -f $tree/infra/edge/Caddyfile ]] ||
    die "not a cantos-vps bundle tree: $tree" 66
  install -d -m 0700 "$ROOT" "$EDGE_DIR"
  rm -rf "$RUNTIME.new"
  install -d -m 0700 "$RUNTIME.new/edge"
  cp -a "$tree/infra/vps/." "$RUNTIME.new/"
  cp "$tree/infra/edge/Caddyfile" "$RUNTIME.new/edge/Caddyfile"
  cp "$tree/REVISION" "$RUNTIME.new/REVISION" 2>/dev/null || true
  [[ -d $RUNTIME ]] && { rm -rf "$RUNTIME.previous"; mv "$RUNTIME" "$RUNTIME.previous"; }
  mv "$RUNTIME.new" "$RUNTIME"

  local changed=() file name
  for file in "$RUNTIME"/quadlet/*; do
    name=$(basename "$file")
    if ! cmp -s "$file" "$QUADLET_DIR/$name"; then
      install -D -m 0644 "$file" "$QUADLET_DIR/$name"
      changed+=("${name%.*}")
    fi
  done
  for file in "$RUNTIME"/systemd/*; do
    install -m 0644 "$file" "$SYSTEMD_DIR/$(basename "$file")"
  done
  install -m 0750 "$RUNTIME/bin/cantos-vps" /usr/local/sbin/cantos-vps
  local caddy_changed=false
  if ! cmp -s "$RUNTIME/edge/Caddyfile" "$EDGE_DIR/Caddyfile"; then
    install -m 0644 "$RUNTIME/edge/Caddyfile" "$EDGE_DIR/Caddyfile"
    caddy_changed=true
  fi
  systemctl daemon-reload

  # API units restart during `deploy`; other running services pick up a changed unit now.
  local unit
  for unit in "${changed[@]}"; do
    case $unit in
      cantos-api-*|cantos) ;;
      *) if unit_active "$unit"; then log "restarting changed $unit"; systemctl restart "$unit.service"; fi ;;
    esac
  done
  if $caddy_changed && unit_active cantos-edge; then
    podman exec cantos-edge caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null
    podman exec cantos-edge caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
    log "edge configuration reloaded"
  fi
  log "installed bundle ($(cat "$RUNTIME/REVISION" 2>/dev/null || echo unknown))"
}

# -------------------------------------------------------------------------------- bootstrap

ensure_password() {
  local file=$SECRETS/$1.password
  [[ -s $file ]] || { openssl rand -hex 32 >"$file"; chmod 0600 "$file"; log "generated $1 password"; }
}

put_secret() { # NAME VALUE-from-stdin; replaces so a rotated file propagates on next restart
  # Podman reads `-` only from a pipe, never from a redirected regular file.
  cat | podman secret create --replace "$1" - >/dev/null
}

ensure_internal_ca() {
  if [[ ! -s $CA_DIR/ca.key ]]; then
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 3650 \
      -subj "/CN=Cantos VPS internal CA" \
      -addext basicConstraints=critical,CA:TRUE,pathlen:0 \
      -addext keyUsage=critical,keyCertSign,cRLSign \
      -keyout "$CA_DIR/ca.key" -out "$CA_DIR/ca.pem" 2>/dev/null
    log "created private CA for container-internal TLS"
  fi
  install -m 0644 "$CA_DIR/ca.pem" "$EDGE_DIR/internal-ca.pem"
}

ensure_kanidm_tls() {
  local leaf=$KANIDM_DIR/leaf.pem
  if [[ -s $leaf ]] && openssl x509 -checkend $((30 * 86400)) -noout -in "$leaf" >/dev/null &&
    openssl verify -CAfile "$CA_DIR/ca.pem" "$leaf" >/dev/null 2>&1; then
    return
  fi
  local csr
  csr=$(mktemp)
  openssl req -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -subj /CN=cantos-kanidm \
    -keyout "$KANIDM_DIR/key.pem" -out "$csr" 2>/dev/null
  openssl x509 -req -in "$csr" -CA "$CA_DIR/ca.pem" -CAkey "$CA_DIR/ca.key" -CAcreateserial \
    -days 397 -out "$leaf" -extfile <(printf '%s\n' \
      'subjectAltName=DNS:cantos-kanidm,DNS:localhost' 'basicConstraints=critical,CA:FALSE' \
      'keyUsage=critical,digitalSignature' 'extendedKeyUsage=serverAuth') 2>/dev/null
  rm -f "$csr"
  cat "$leaf" "$CA_DIR/ca.pem" >"$KANIDM_DIR/chain.pem"
  chmod 0600 "$KANIDM_DIR/key.pem" "$KANIDM_DIR/chain.pem" "$leaf"
  log "issued Kanidm internal certificate"
  if unit_active cantos-kanidm; then systemctl restart cantos-kanidm.service; fi
}

render_configuration() {
  [[ -f $CONFIG/edge.env ]] || {
    install -m 0600 "$RUNTIME/config.example.env" "$CONFIG/edge.env"
    die "created $CONFIG/edge.env from the example; review all origins, callbacks and Firebase site IDs, then rerun" 66
  }
  local idm
  validate_browser_configuration
  edge_value CANTOS_THEATRE_HOST >/dev/null
  edge_value CANTOS_STUDIO_HOST >/dev/null
  idm=$(edge_value CANTOS_IDM_HOST)
  edge_value CANTOS_THEATRE_FIREBASE_SITE >/dev/null
  edge_value CANTOS_STUDIO_FIREBASE_SITE >/dev/null
  render_api_configuration
  sed "s/@IDM_HOST@/$idm/g" "$RUNTIME/kanidm/server.toml.template" >"$KANIDM_DIR/server.toml"
  # APIs and the Kanidm CLI reach the identity provider by its public name on the private
  # network; the edge answers it with the public certificate. No hairpin through the host.
  install -d -m 0755 "$QUADLET_DIR/cantos-edge.container.d"
  printf '[Container]\nNetworkAlias=%s\n' "$idm" >"$QUADLET_DIR/cantos-edge.container.d/10-identity-alias.conf"
  chmod 0644 "$QUADLET_DIR/cantos-edge.container.d/10-identity-alias.conf"
}

provision_database() {
  local owner app
  owner=$(<"$SECRETS/db-owner.password")
  app=$(<"$SECRETS/db-app.password")
  psql_superuser postgres <"$RUNTIME/postgres/roles.sql" >/dev/null
  # Passwords travel on stdin only; hex values need no quoting.
  printf "ALTER ROLE cantos_owner PASSWORD '%s';\nALTER ROLE cantos_app PASSWORD '%s';\n" \
    "$owner" "$app" | psql_superuser postgres >/dev/null
  log "database roles and ownership provisioned"
}

psql_superuser() { # DB; SQL on stdin
  podman exec -i cantos-postgres sh -c \
    'PGPASSWORD="$(cat /run/secrets/postgres-password)" exec psql -X -q -v ON_ERROR_STOP=1 -U postgres -d "$1"' \
    sh "$1"
}

# ufw denies routed and unsolicited input traffic; Podman's nftables rules cannot override it.
# Route only the cantos0 bridge: published edge ports in, container egress (ACME, Firebase) out.
open_firewall() {
  if command -v ufw >/dev/null && ufw status | grep -q '^Status: active'; then
    ufw allow 80/tcp >/dev/null
    ufw allow 443/tcp >/dev/null
    ufw allow 443/udp >/dev/null
    ufw route allow in on cantos0 >/dev/null
    ufw route allow out on cantos0 >/dev/null
    # Container name resolution is Podman's aardvark-dns on the bridge gateway (host input).
    ufw allow in on cantos0 to any port 53 >/dev/null
    log "ufw allows 80/tcp, 443/tcp, 443/udp, cantos0 routing and cantos0 DNS"
  fi
}

bootstrap() {
  require_root
  with_lock
  [[ -d $RUNTIME ]] || die "run cantos-vps install TREE_DIR first" 66
  install -d -m 0700 "$ROOT" "$CONFIG" "$STATE" "$SECRETS" "$BACKUPS" "$KANIDM_DIR" "$EDGE_DIR" "$CA_DIR"
  render_configuration
  ensure_password postgres-superuser
  ensure_password db-owner
  ensure_password db-app
  put_secret cantos-postgres-superuser <"$SECRETS/postgres-superuser.password"
  printf 'postgresql://cantos_owner:%s%s' "$(<"$SECRETS/db-owner.password")" "$SOCKET_URL_SUFFIX" |
    put_secret cantos-db-owner-url
  printf 'postgresql://cantos_app:%s%s' "$(<"$SECRETS/db-app.password")" "$SOCKET_URL_SUFFIX" |
    put_secret cantos-db-app-url
  ensure_internal_ca
  ensure_kanidm_tls
  open_firewall
  systemctl daemon-reload
  systemctl start cantos-network.service cantos-postgres.service
  provision_database
  systemctl start cantos-kanidm.service cantos-edge.service
  systemctl enable --now cantos-backup.timer >/dev/null
  log "bootstrap complete; deploy an API image with: cargo xtask deploy vps cantos-api"
}

# ----------------------------------------------------------------------------------- backup

backup() {
  local label=${1:-manual}
  [[ $label =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "invalid backup label" 65
  unit_active cantos-postgres || die "cantos-postgres is not running" 69
  install -d -m 0700 "$BACKUPS" || die "cannot create backup directory" 70
  local stamp file epoch
  stamp=$(date -u +%Y%m%dT%H%M%SZ) || die "cannot timestamp backup" 70
  file=$BACKUPS/cantos-$stamp-$label.dump
  podman exec cantos-postgres sh -c \
    'PGPASSWORD="$(cat /run/secrets/postgres-password)" exec pg_dump -U postgres -d cantos -Fc' \
    >"$file.partial" || die "database dump failed; partial archive retained at $file.partial" 70
  [[ -s $file.partial ]] || die "empty backup" 70
  if ! epoch=$(database_schema_epoch); then
    epoch=unrecognized
    log "schema epoch unavailable; preserving backup with unrecognized metadata (ordinary restore will refuse it)"
  fi
  # deploy captures backup's path in a command substitution. Bash disables implicit errexit
  # there, so every step needed for a usable backup must explicitly propagate failure.
  printf '%s\n' "$epoch" >"$file.schema-epoch.partial" || die "cannot record backup schema epoch" 70
  mv "$file.partial" "$file" || die "cannot finalize database dump" 70
  mv "$file.schema-epoch.partial" "$file.schema-epoch" || die "cannot finalize backup schema epoch" 70
  (cd "$BACKUPS" && sha256sum "$(basename "$file")" "$(basename "$file").schema-epoch" >"$(basename "$file").sha256.partial") ||
    die "cannot checksum backup; no retention or deployment may proceed" 70
  [[ $epoch != unrecognized ]] ||
    die "backup preserved at $file but schema epoch is unknown; no retention or deployment may proceed" 70
  mv "$file.sha256.partial" "$file.sha256" || die "cannot finalize backup checksum" 70
  log "backup $file ($(du -h "$file" | cut -f1))"
  local old
  # Only a finalized checksum manifest commits a usable backup. Failed dump/metadata/hash
  # artifacts stay available for investigation and never displace a known recovery point.
  while IFS= read -r old; do
    old=${old%.sha256}
    rm -f "$old" "$old.sha256" "$old.schema-epoch"
  done < <(ls -1t "$BACKUPS"/cantos-*.dump.sha256 2>/dev/null | tail -n +$((BACKUP_KEEP + 1)))
  printf '%s\n' "$file"
}

restore() {
  local file=${1:-} confirm=${2:-}
  require_root
  with_lock
  [[ $confirm == --yes-replace-database ]] || die "restore replaces the cantos database; pass --yes-replace-database" 64
  [[ -f $file && -f $file.sha256 && -f $file.schema-epoch ]] ||
    die "backup, checksum or schema-epoch metadata missing; historical restore needs its reviewed legacy bundle" 66
  # Validate names before sha256sum can read a foreign path. A valid sidecar checksum alone
  # says nothing about the archive that pg_restore will consume.
  awk -v dump="$(basename "$file")" '
    {
      hash = substr($0, 1, 64); name = substr($0, 67)
      if (length(hash) != 64 || hash !~ /^[0-9a-f]+$/ || substr($0, 65, 2) != "  ") exit 1
      if (name == dump && !seen_dump) seen_dump = 1
      else if (name == dump ".schema-epoch" && !seen_epoch) seen_epoch = 1
      else exit 1
    }
    END { exit !(NR == 2 && seen_dump && seen_epoch) }
  ' "$file.sha256" || die "dump or schema-epoch metadata is not covered by the backup checksum (requires exactly these two files)" 65
  (cd "$(dirname "$file")" && sha256sum -c --quiet "$(basename "$file").sha256") || die "checksum mismatch" 65
  [[ $(<"$file.schema-epoch") == "$SCHEMA_EPOCH" ]] ||
    die "backup schema epoch is not $SCHEMA_EPOCH; use the explicit schema-cutover plan" 65
  [[ -s $STATE/current ]] || die "no current API revision recorded" 66
  local current
  current=$(<"$STATE/current")
  check_revision "$current"
  require_schema_image "$current"
  check_schema "$current" || die "current database schema is incompatible; restore requires an explicit cutover plan" 65
  backup pre-restore >/dev/null
  systemctl stop "${API_UNITS[@]/%/.service}"
  podman exec -i cantos-postgres sh -c \
    'PGPASSWORD="$(cat /run/secrets/postgres-password)" exec pg_restore -U postgres -d cantos --clean --if-exists --single-transaction' \
    <"$file"
  check_schema "$current" || die "restored schema rejected; APIs remain stopped; inspect the backup and recovery plan" 65
  apply_grants
  systemctl start "${API_UNITS[@]/%/.service}"
  log "restored $file"
}

# ----------------------------------------------------------------------------------- deploy

image_for() { printf '%s:%s' "$IMAGE_REPO" "$1"; }

check_revision() {
  local revision=$1
  [[ $revision =~ ^[0-9a-f]{40}$ ]] || die "revision must be a full 40-hex commit" 65
  podman image exists "$(image_for "$revision")" || die "image not loaded: $(image_for "$revision")" 66
  local label
  label=$(podman image inspect --format '{{ index .Labels "org.opencontainers.image.revision" }}' "$(image_for "$revision")")
  [[ $label == "$revision" ]] || die "image revision label $label does not match $revision" 65
}

run_migrator() {
  local revision=$1
  shift
  podman run --rm --network none --pull never \
    --secret cantos-db-owner-url,type=env,target=DATABASE_URL \
    -v cantos-postgres-socket:/run/postgresql \
    --entrypoint /usr/local/bin/cantos-migrate "$(image_for "$revision")" "$@"
}

check_schema() { run_migrator "$1" --check; }
migrate() { run_migrator "$1"; }

require_schema_image() {
  local epoch
  epoch=$(podman image inspect --format '{{ index .Labels "io.cantos.schema-epoch" }}' "$(image_for "$1")")
  [[ $epoch == "$SCHEMA_EPOCH" ]] ||
    die "image $1 does not declare schema epoch $SCHEMA_EPOCH; cross-epoch deploy/rollback needs an explicit cutover" 65
}

# Conservative read-only empty-install probe. Any user schema, relation, routine or type
# prevents fresh bootstrap; the migrator independently checks again under its database lock.
database_is_empty() {
  local empty
  empty=$(psql_superuser cantos <<'SQL'
\pset tuples_only on
\pset format unaligned
BEGIN READ ONLY;
SELECT NOT EXISTS (
    SELECT 1 FROM pg_namespace n
    WHERE n.nspname <> 'public' AND n.nspname <> 'information_schema'
        AND n.nspname !~ '^pg_'
) AND NOT EXISTS (
    SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
    WHERE n.nspname <> 'information_schema' AND n.nspname !~ '^pg_'
) AND NOT EXISTS (
    SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE n.nspname <> 'information_schema' AND n.nspname !~ '^pg_'
) AND NOT EXISTS (
    SELECT 1 FROM pg_type t JOIN pg_namespace n ON n.oid = t.typnamespace
    WHERE n.nspname <> 'information_schema' AND n.nspname !~ '^pg_'
);
COMMIT;
SQL
  ) || return 1
  [[ $empty == t ]]
}

database_schema_epoch() {
  if database_is_empty; then printf 'empty\n'; return; fi
  local marker epoch
  marker=$(printf '\\pset tuples_only on\n\\pset format unaligned\nSELECT to_regclass('\''public.cantos_schema'\'') IS NOT NULL;\n' |
    psql_superuser cantos) || return 1
  if [[ $marker != t ]]; then printf 'legacy\n'; return; fi
  epoch=$(printf '\\pset tuples_only on\n\\pset format unaligned\nBEGIN READ ONLY; SELECT epoch FROM public.cantos_schema; COMMIT;\n' |
    psql_superuser cantos) || return 1
  [[ $epoch =~ ^[0-9]+$ ]] || die "unrecognized schema-epoch registry" 65
  printf '%s\n' "$epoch"
}

preflight_schema() {
  local revision=$1
  require_schema_image "$revision"
  if ! database_is_empty; then
    check_schema "$revision" ||
      die "database is not current schema epoch $SCHEMA_EPOCH; no migration or image switch attempted; inventory and approved cutover required" 65
  fi
}

# Registration is configured outside this script (a drop-in or EnvironmentFile for the Theatre
# API). Only an explicit ENABLED=true grants the registration tables; anything else revokes them.
registration_enabled() {
  grep -rqsE '^[[:space:]]*(Environment=)?"?CANTOS_THEATRE_REGISTRATION_ENABLED=true"?[[:space:]]*$' \
    "$CONFIG" "$QUADLET_DIR/cantos-api-theatre.container.d"
}

apply_grants() {
  local registration=theatre-registration-revoke.sql
  registration_enabled && registration=theatre-registration-grants.sql
  {
    printf 'SET ROLE cantos_owner;\n'
    cat "$RUNTIME/postgres/runtime-grants.sql" "$RUNTIME/postgres/$registration"
  } | psql_superuser cantos >/dev/null
  log "runtime grants applied (${registration%.sql})"
}

switch_to() {
  podman tag "$(image_for "$1")" "$(image_for current)"
  local unit failed=0
  for unit in "${API_UNITS[@]}"; do
    # Notify=healthy: restart returns only after the container's health check passes.
    if ! systemctl restart "$unit.service"; then
      log "$unit did not become healthy"
      failed=1
    fi
  done
  return "$failed"
}

edge_probe() {
  unit_active cantos-edge || { log "edge not running; skipped public probe"; return 0; }
  local api theatre studio
  api=$(edge_value CANTOS_API_HOST)
  theatre=$(edge_value CANTOS_THEATRE_HOST)
  studio=$(edge_value CANTOS_STUDIO_HOST)
  curl -fsS -o /dev/null --max-time 15 --resolve "$api:443:127.0.0.1" "https://$api/api/v1/theatre/works" &&
    curl -fsS -o /dev/null --max-time 15 --resolve "$theatre:443:127.0.0.1" "https://$theatre/api/v1/theatre/works" &&
    curl -sS -o /dev/null --max-time 15 --resolve "$studio:443:127.0.0.1" -w '%{http_code}' \
      "https://$studio/api/v1/studio/auth/configuration" | grep -Eq '^(200|503)$'
}

deploy() {
  local revision=${1:-}
  require_root
  with_lock
  validate_runtime_browser_configuration
  check_revision "$revision"
  unit_active cantos-postgres || die "cantos-postgres is not running; run cantos-vps bootstrap" 69
  preflight_schema "$revision"
  local previous=""
  [[ -s $STATE/current ]] && previous=$(<"$STATE/current")
  if [[ -n $previous && $previous != "$revision" ]]; then
    check_revision "$previous"
    require_schema_image "$previous"
    # Automatic rollback must be usable before the new image changes anything.
    if ! database_is_empty; then check_schema "$previous" || die "previous image cannot serve the current schema" 65; fi
  fi
  log "deploying $revision (previous: ${previous:-none})"
  local dump
  dump=$(backup "pre-${revision:0:12}")
  migrate "$revision" || die "migration failed; database unchanged by the failed transaction, backup $dump" 70
  apply_grants
  if switch_to "$revision" && edge_probe; then
    [[ -n $previous && $previous != "$revision" ]] && printf '%s\n' "$previous" >"$STATE/previous"
    printf '%s\n' "$revision" >"$STATE/current"
    printf '%s deploy %s ok\n' "$(date -u +%FT%TZ)" "$revision" >>"$STATE/history"
    prune_releases
    log "deployed $revision"
    return 0
  fi
  printf '%s deploy %s failed\n' "$(date -u +%FT%TZ)" "$revision" >>"$STATE/history"
  if [[ -n $previous ]]; then
    log "health gate failed; rolling back to $previous (schema stays migrated; backup $dump)"
    switch_to "$previous" || die "rollback to $previous is unhealthy too; inspect journalctl -u cantos-api-*" 71
    die "deploy of $revision failed and was rolled back to $previous" 72
  fi
  die "first deploy of $revision failed health checks; inspect journalctl -u cantos-api-*" 72
}

cutover_retained_revisions() {
  local directory=$STATE/epoch2-cutovers journal file phase line key value required
  [[ -e $directory || -L $directory ]] || return 0
  [[ -d $directory && ! -L $directory && -r $directory && -x $directory ]] || return 1
  for journal in "$directory"/* "$directory"/.[!.]* "$directory"/..?*; do
    [[ -e $journal || -L $journal ]] || continue
    [[ -d $journal && ! -L $journal && -r $journal && -x $journal ]] || return 1
    for file in meta phase; do
      [[ -f $journal/$file && ! -L $journal/$file && -r $journal/$file ]] || return 1
    done
    phase=$(<"$journal/phase") || return 1
    case $phase in
      initializing|snapshotted|freeze-intent|prepared|browser-intent|rename-intent|health-check|accepted|complete|refused|rolled-back) ;;
      *) return 1 ;;
    esac
    local -A metadata=()
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == *=* ]] || return 1
      key=${line%%=*}; value=${line#*=}
      [[ $key =~ ^[a-z_]+$ ]] || return 1
      [[ -z ${metadata[$key]+present} ]] || return 1
      case $key in
        target|previous) [[ $value =~ ^[0-9a-f]{40}$ ]] || return 1 ;;
        attempt) [[ $value =~ ^[0-9a-f]{32}$ ]] || return 1 ;;
        oracle) [[ $value =~ ^cantos_e1_oracle_[a-z0-9_]+$ && ${#value} -le 63 ]] || return 1 ;;
        rehearsal) [[ $value =~ ^cantos_e1_restore_[a-z0-9_]+$ && ${#value} -le 63 ]] || return 1 ;;
        staging) [[ $value =~ ^cantos_e2_stage_[a-z0-9_]+$ && ${#value} -le 63 ]] || return 1 ;;
        retained) [[ $value =~ ^cantos_e1_retained_[a-z0-9_]+$ && ${#value} -le 63 ]] || return 1 ;;
        old_oid|new_oid) [[ $value =~ ^[0-9]+$ ]] || return 1 ;;
        old_limit) [[ $value =~ ^(-1|[0-9]+)$ ]] || return 1 ;;
        *) return 1 ;;
      esac
      metadata[$key]=$value
    done <"$journal/meta" || return 1
    for required in target previous oracle rehearsal staging retained old_oid old_limit; do
      [[ -n ${metadata[$required]:-} ]] || return 1
    done
    if [[ $phase == accepted || $phase == complete ]]; then
      [[ -n ${metadata[new_oid]:-} ]] || return 1
    fi
    if [[ -n ${metadata[attempt]:-} ]]; then
      [[ ${journal##*/} == "${metadata[target]:0:12}-${metadata[attempt]}" ]] || return 1
    else
      [[ ${journal##*/} =~ ^${metadata[target]:0:12}-[0-9]+-[0-9]+$ ]] || return 1
    fi
    printf '%s\n' "${metadata[target]}" "${metadata[previous]}" || return 1
  done
}

# Completed/failed cutovers retain paired recovery dependencies across ordinary deploys.
# Validate every journal before deleting anything: unknown metadata means retain everything.
prune_releases() {
  local retained tag old name identity
  if ! retained=$(cutover_retained_revisions); then
    log "cutover recovery metadata unavailable or invalid; skipping all release pruning"
    return 0
  fi
  local keep=("$(cat "$STATE/current" 2>/dev/null)" "$(cat "$STATE/previous" 2>/dev/null)")
  while IFS= read -r tag; do
    [[ -z $tag ]] || keep+=("$tag")
  done <<<"$retained"
  while IFS= read -r tag; do
    [[ $tag =~ ^[0-9a-f]{40}$ ]] || continue
    [[ " ${keep[*]} " != *" $tag "* ]] || continue
    identity=$(podman image inspect --format '{{ index .Labels "org.opencontainers.image.title" }}|{{ index .Labels "org.opencontainers.image.revision" }}|{{ index .Labels "org.opencontainers.image.source" }}' "$(image_for "$tag")" 2>/dev/null) || continue
    [[ $identity == "cantos-api|$tag|https://github.com/loveoverflowcom/cantos" ]] || continue
    podman rmi "$(image_for "$tag")" >/dev/null 2>&1 || true
  done < <(podman images --format '{{.Tag}}' "$IMAGE_REPO")
  local -a uploads=()
  for old in "$ROOT"/incoming/*; do
    name=${old##*/}
    [[ -d $old && ! -L $old && $name =~ ^[0-9a-f]{40}$ ]] || continue
    uploads+=("$old")
  done
  [[ ${#uploads[@]} -gt 3 ]] || return 0
  while IFS= read -r old; do
    name=${old##*/}
    [[ " ${keep[*]} " != *" $name "* ]] || continue
    rm -rf "$old"
  done < <(ls -1dt -- "${uploads[@]}" | tail -n +4)
}

rollback() {
  require_root
  with_lock
  validate_runtime_browser_configuration
  [[ -s $STATE/previous ]] || die "no previous revision recorded" 66
  local previous current
  previous=$(<"$STATE/previous")
  current=$(<"$STATE/current")
  check_revision "$previous"
  require_schema_image "$previous"
  check_schema "$previous" || die "previous image cannot serve this schema; no image switch attempted" 65
  switch_to "$previous" || die "previous revision $previous is unhealthy" 71
  printf '%s\n' "$current" >"$STATE/previous"
  printf '%s\n' "$previous" >"$STATE/current"
  printf '%s rollback %s\n' "$(date -u +%FT%TZ)" "$previous" >>"$STATE/history"
  log "rolled back to $previous (schema unchanged; restore a backup only if required)"
}

status() {
  local unit
  for unit in cantos-network cantos-postgres cantos-kanidm cantos-edge "${API_UNITS[@]}"; do
    printf '%-22s %s\n' "$unit" "$(systemctl is-active "$unit.service" 2>/dev/null || true)"
  done
  podman ps --filter label=io.cantos.owner=cantos-vps --format '{{.Names}}\t{{.Status}}'
  printf 'current  %s\nprevious %s\n' "$(cat "$STATE/current" 2>/dev/null || echo -)" \
    "$(cat "$STATE/previous" 2>/dev/null || echo -)"
  ls -1t "$BACKUPS"/cantos-*.dump 2>/dev/null | head -3 || true
}

# --------------------------------------------------------------------------------- identity

kanidm_cli() { # runs the pinned CLI on the private network as idm_admin; args are the command
  local idm=$1
  shift
  KANIDM_PASSWORD=$(<"$SECRETS/kanidm-idm-admin.password") podman run --rm --network cantos \
    --pull missing -e KANIDM_PASSWORD -e KANIDM_URL="https://$idm" -e KANIDM_NAME=idm_admin \
    -e RUST_LOG=error -v cantos-kanidm-cli:/root/.cache "$KANIDM_TOOLS" sh -c \
    'kanidm login -D idm_admin >/dev/null && exec "$@"' sh "$@"
}

# `kanidm ... get` exits 0 for a missing entry too; only JSON output with attrs proves existence.
kanidm_exists() { # IDM KIND... NAME
  local idm=$1
  shift
  kanidm_cli "$idm" kanidm "$@" -o json 2>/dev/null | grep -q '"attrs"'
}

ensure_idm_admin() {
  [[ -s $SECRETS/kanidm-idm-admin.password ]] && return
  # The pinned server prints `new_password: "..."`; capture it straight into a root-only file.
  podman exec cantos-kanidm /sbin/kanidmd recover-account idm_admin -c /config/server.toml 2>&1 |
    sed -nE 's/.*new_password: "([^"]+)".*/\1/p' >"$SECRETS/kanidm-idm-admin.password"
  chmod 0600 "$SECRETS/kanidm-idm-admin.password"
  [[ -s $SECRETS/kanidm-idm-admin.password ]] || die "could not recover idm_admin" 70
  log "idm_admin recovered; its password stays in $SECRETS (root only)"
}

ensure_client() { # IDM CLIENT DISPLAY ORIGIN CALLBACK GROUP SECRET-NAME
  local idm=$1 client=$2 display=$3 origin=$4 callback=$5 group=$6 secret=$7
  kanidm_exists "$idm" group get "$group" || kanidm_cli "$idm" kanidm group create "$group" >/dev/null
  kanidm_exists "$idm" system oauth2 get "$client" ||
    kanidm_cli "$idm" kanidm system oauth2 create "$client" "$display" "$origin" >/dev/null
  kanidm_cli "$idm" kanidm system oauth2 add-redirect-url "$client" "$callback" >/dev/null
  kanidm_cli "$idm" kanidm system oauth2 update-scope-map "$client" "$group" openid >/dev/null
  local value
  value=$(kanidm_cli "$idm" kanidm system oauth2 show-basic-secret "$client" 2>/dev/null | tail -n 1 | tr -d '\r\n')
  [[ $value =~ ^[A-Za-z0-9_-]{16,}$ ]] || die "could not read the $client client secret" 70
  printf '%s' "$value" | put_secret "$secret"
  log "$client configured; its secret is the Podman secret $secret"
}

configure_browser_clients() {
  local idm=$1 studio theatre studio_callback theatre_callback
  studio=$(browser_origin studio WEB) || return $?
  theatre=$(browser_origin theatre WEB) || return $?
  studio_callback=$(deployment_value CANTOS_STUDIO_OIDC_CALLBACK) || return $?
  theatre_callback=$(deployment_value CANTOS_THEATRE_OIDC_CALLBACK) || return $?
  ensure_client "$idm" cantos-studio-web-bff "Cantos Studio" "$studio" \
    "$studio_callback" cantos_studio_admins cantos-studio-oidc-secret
  ensure_client "$idm" cantos-theatre-web-bff "Cantos" "$theatre" \
    "$theatre_callback" cantos_theatre_listeners cantos-theatre-oidc-secret
}

ensure_person() { # IDM NAME DISPLAY GROUP -> prints a one-time reset link to this terminal
  local idm=$1 name=$2 display=$3 group=$4
  [[ $name =~ ^[a-z][a-z0-9_-]{1,63}$ ]] || die "account name must be lowercase [a-z0-9_-]" 65
  kanidm_exists "$idm" person get "$name" ||
    kanidm_cli "$idm" kanidm person create "$name" "$display" >/dev/null
  kanidm_cli "$idm" kanidm group add-members "$group" "$name" >/dev/null
  printf '\nOne-time credential setup for %s, valid 24 hours (open it yourself; do not share it):\n' "$name"
  kanidm_cli "$idm" kanidm person credential create-reset-token --ttl 86400 "$name"
}

person_uuid() {
  kanidm_cli "$1" kanidm person get "$2" -o json | python3 -c 'import json,sys
for line in sys.stdin:
    line=line.strip()
    if line.startswith("{"):
        attrs=json.loads(line).get("attrs", {})
        print(attrs["uuid"][0]); break'
}

identity() {
  require_root
  if [[ ${1:-} == --reconcile-existing ]]; then
    [[ $# -eq 1 ]] || die 'identity --reconcile-existing takes no account or reset options' 64
    CANTOS_VPS_HELPERS=$RUNTIME/bin
    source "$CANTOS_VPS_HELPERS/cantos-oidc-reconcile"
    reconcile_existing_identity
    return
  fi
  local admin="" display="" listener=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --studio-admin) admin=${2:-}; shift 2 ;;
      --display) display=${2:-}; shift 2 ;;
      --listener) listener=${2:-}; shift 2 ;;
      *) die "unknown identity option $1" 64 ;;
    esac
  done
  [[ -n $admin ]] || die "usage: cantos-vps identity --studio-admin NAME [--display TEXT] [--listener NAME]" 64
  [[ -t 1 ]] || die "identity prints one-time links; run it in your own interactive terminal" 64
  with_lock
  unit_active cantos-kanidm && unit_active cantos-edge || die "kanidm and edge must be running" 69
  validate_browser_configuration
  local idm studio_callback theatre_callback
  idm=$(edge_value CANTOS_IDM_HOST)
  studio_callback=$(deployment_value CANTOS_STUDIO_OIDC_CALLBACK)
  theatre_callback=$(deployment_value CANTOS_THEATRE_OIDC_CALLBACK)
  ensure_idm_admin
  configure_browser_clients "$idm"
  ensure_person "$idm" "$admin" "${display:-$admin}" cantos_studio_admins
  [[ -z $listener ]] || ensure_person "$idm" "$listener" "$listener" cantos_theatre_listeners

  local subject
  subject=$(person_uuid "$idm" "$admin")
  [[ $subject =~ ^[0-9a-f-]{36}$ ]] || die "could not read the Studio administrator subject" 70
  printf 'CANTOS_STUDIO_OIDC_ISSUER=https://%s/oauth2/openid/cantos-studio-web-bff\nCANTOS_STUDIO_ADMIN_SUBJECTS=["%s"]\n' \
    "$idm" "$subject" >"$CONFIG/api-studio-oidc.env"
  printf 'CANTOS_THEATRE_OIDC_ISSUER=https://%s/oauth2/openid/cantos-theatre-web-bff\n' \
    "$idm" >"$CONFIG/api-theatre-oidc.env"
  # Input receipt only: this records completed client configuration, never live login or the
  # removal of old provider redirects. Those still require operator reconciliation/acceptance.
  printf 'CANTOS_STUDIO_OIDC_CALLBACK=%s\nCANTOS_THEATRE_OIDC_CALLBACK=%s\n' \
    "$studio_callback" "$theatre_callback" >"$CONFIG/oidc-callbacks.env"
  render_api_configuration
  local surface
  for surface in studio theatre; do
    install -d -m 0755 "$QUADLET_DIR/cantos-api-$surface.container.d"
    printf '[Container]\nEnvironmentFile=%s\nSecret=cantos-%s-oidc-secret,type=env,target=CANTOS_%s_OIDC_SECRET\n' \
      "$CONFIG/api-$surface-oidc.env" "$surface" "${surface^^}" \
      >"$QUADLET_DIR/cantos-api-$surface.container.d/20-oidc.conf"
    chmod 0644 "$QUADLET_DIR/cantos-api-$surface.container.d/20-oidc.conf"
  done
  systemctl daemon-reload
  if podman image exists "$(image_for current)"; then
    systemctl restart "${API_UNITS[@]/%/.service}"
  fi
  log "Studio OIDC admits only subject $subject; Theatre sign-in is limited to cantos_theatre_listeners"
}

main() {
  local command=${1:-}
  shift || true
  if [[ -s $STATE/epoch2-cutover.pending ]]; then
    case $command in
      status|cutover-prepare|cutover-commit|cutover-recover) ;;
      *) die 'epoch2 cutover pending; reconcile through its incoming cutover-recover command' 75 ;;
    esac
  fi
  case $command in
    cutover-prepare|cutover-commit|cutover-recover)
      [[ $# -eq 3 && $1 =~ ^[0-9a-f]{40}$ && ${3:-} =~ ^[0-9a-f]{32}$ &&
         $2 == "$ROOT/incoming/$1/$3/tree" ]] ||
        die 'cutover requires REVISION, its exact incoming attempt tree and ATTEMPT_ID' 64
      [[ -f $2/REVISION && $(<"$2/REVISION") == "$1" ]] || die 'cutover bundle revision mismatch' 65
      CANTOS_VPS_HELPERS=$2/infra/vps/bin
      source "$CANTOS_VPS_HELPERS/cantos-oidc-reconcile"
      source "$CANTOS_VPS_HELPERS/cantos-epoch2-cutover"
      case $command in
        cutover-prepare) epoch2_prepare "$@" ;;
        cutover-commit) epoch2_commit "$@" ;;
        cutover-recover) epoch2_recover "$@" ;;
      esac
      ;;
    install) install_bundle "$@" ;;
    bootstrap) bootstrap ;;
    reload-browser) reload_browser "$@" ;;
    deploy) deploy "$@" ;;
    rollback) rollback ;;
    backup) require_root; with_lock; backup "$@" >/dev/null ;;
    restore) restore "$@" ;;
    status) status ;;
    identity) identity "$@" ;;
    *) sed -n '2,22p' "$0" >&2; exit 64 ;;
  esac
}

main "$@"
