# Nonsecret deployment inputs, rendered by `cantos-vps bootstrap` into
# /root/cantos-services/config/*.env (root, 0600). Secrets are Podman secrets, never here.
# Legacy proxy hosts are transitional ingress, never defaults for direct Hosting Web origins.
CANTOS_THEATRE_HOST=cantoss.duckdns.org
CANTOS_STUDIO_HOST=studio.cantoss.duckdns.org
CANTOS_API_HOST=api.cantoss.duckdns.org
# Optional second API hostname during a custom-domain transition. Keep the old hostname
# here after CANTOS_API_HOST becomes api.cantos.cc; omit this key outside a transition.
# CANTOS_API_ALIAS_HOST=api.cantos.cc
CANTOS_IDM_HOST=idm.cantoss.duckdns.org
# Explicit browser policy. Set reviewed direct Hosting/custom-domain origins, even when the
# transitional hosts above remain installed. HTTPS DNS origins only; no port or trailing slash.
# Both API origins must equal https://CANTOS_API_HOST. No same-site domain is selected here.
CANTOS_THEATRE_WEB_ORIGIN=REPLACE_WITH_REVIEWED_THEATRE_HTTPS_ORIGIN
CANTOS_STUDIO_WEB_ORIGIN=REPLACE_WITH_REVIEWED_STUDIO_HTTPS_ORIGIN
CANTOS_THEATRE_API_ORIGIN=REPLACE_WITH_REVIEWED_API_HTTPS_ORIGIN
CANTOS_STUDIO_API_ORIGIN=REPLACE_WITH_REVIEWED_API_HTTPS_ORIGIN
# Exact callbacks on the API origin, with the matching surface path. Authorized identity setup
# consumes these same inputs. A deploy never changes clients, issuer bindings or domain/cookies.
CANTOS_THEATRE_OIDC_CALLBACK=REPLACE_WITH_THEATRE_API_ORIGIN/api/v1/theatre/auth/callback
CANTOS_STUDIO_OIDC_CALLBACK=REPLACE_WITH_STUDIO_API_ORIGIN/api/v1/studio/auth/callback
# Firebase Hosting site IDs (the part before .web.app); mapped in infra/firebase/hosting/.firebaserc.
# Distinct labels of at most 30 characters, no dots/URLs. Desired cantos / cantos-studio names
# need verified allocation first; changing an upstream does not change the public hosts above.
CANTOS_THEATRE_FIREBASE_SITE=REPLACE_WITH_THEATRE_SITE_ID
CANTOS_STUDIO_FIREBASE_SITE=REPLACE_WITH_STUDIO_SITE_ID
