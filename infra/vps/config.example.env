# Nonsecret deployment inputs, rendered by `cantos-vps bootstrap` into
# /root/cantos-services/config/*.env (root, 0600). Secrets are Podman secrets, never here.
CANTOS_THEATRE_HOST=cantoss.duckdns.org
CANTOS_STUDIO_HOST=studio.cantoss.duckdns.org
CANTOS_API_HOST=api.cantoss.duckdns.org
CANTOS_IDM_HOST=idm.cantoss.duckdns.org
# Firebase Hosting site IDs (the part before .web.app); mapped in infra/firebase/hosting/.firebaserc.
CANTOS_THEATRE_FIREBASE_SITE=REPLACE_WITH_THEATRE_SITE_ID
CANTOS_STUDIO_FIREBASE_SITE=REPLACE_WITH_STUDIO_SITE_ID
