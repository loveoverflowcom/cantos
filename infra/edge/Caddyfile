# Public HTTPS edge for the Cantos VPS (ADR 0039). Caddy obtains and renews one Let's Encrypt
# certificate per host (HTTP-01 on port 80), so DNS must already point at this machine;
# DuckDNS resolves every subdomain of `cantoss` to the same address.
#
#   {$CANTOS_THEATRE_HOST}  Cantos Theatre Web (listeners) + its /api/*
#   {$CANTOS_STUDIO_HOST}   Cantos Studio Web (creators)   + its /api/*
#   {$CANTOS_API_HOST}      Cantos API for non-browser clients (native apps, producers)
#   {$CANTOS_IDM_HOST}      Kanidm sign-in pages and OIDC endpoints
#
# Every value comes from /root/cantos-services/config/edge.env; nothing here names a project.
#
# This file retains ADR 0039's transitional Web/identity proxies. ADR 0041 selects direct
# Firebase Hosting with explicit client API origin and exact-origin API CORS. Installed files
# do not change with source; reconcile through the current production runbook before rollout.
# Theatre and Studio keep independent origin-pinned API processes and permission boundaries.

{
	# The admin API stays inside the container; reloads use `caddy reload` there.
	admin localhost:2019
}

# `?` sets a default only: the API's stricter `Referrer-Policy: no-referrer` must survive.
(cantos_security) {
	header {
		?X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# An absent or unhealthy upstream is a dial error (502/504), reported as an honest 503.
(cantos_errors) {
	handle_errors 502 503 504 {
		@api path /api/*
		handle @api {
			header Content-Type application/json
			header Retry-After 60
			respond `{"error":"api_unavailable"}` 503
		}
		handle {
			header Content-Type "text/plain; charset=utf-8"
			header Retry-After 60
			respond "Cantos is temporarily unavailable." 503
		}
	}
}

# One API process per Web origin. JSON is compressed here; the API owns Cache-Control.
# X-Forwarded-For is *replaced* with the TCP peer Caddy actually saw, never appended to a
# client-supplied value, so the API can read it as the client address when (and only when) it
# is configured with this container network as its trusted proxy
# (CANTOS_THEATRE_REGISTRATION_PEER_POLICY=trusted_proxy, see docs/deployment/vps-production.md).
# `Forwarded` and `X-Real-IP` are dropped because the API gives them no meaning.
(cantos_api) {
	encode zstd gzip
	reverse_proxy {args[0]}:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up -Forwarded
		header_up -X-Real-IP
	}
}

# Theatre API routes. Anonymous registration bodies are tiny; the API enforces its own 8 KiB
# limit and this rejects larger bodies at the edge before they reach the process.
(cantos_theatre_api) {
	handle /api/v1/theatre/auth/registration* {
		request_body {
			max_size 16KB
		}
		import cantos_api cantos-api-theatre
	}
	handle /api/* {
		import cantos_api cantos-api-theatre
	}
}

# A Firebase Hosting site as the static origin. Host must be the *.web.app name for Firebase
# routing. Its own HSTS/Alt-Svc describe web.app, not this host, so they are replaced/dropped.
(firebase_site) {
	reverse_proxy https://{args[0]}.web.app {
		header_up Host {upstream_hostport}
		header_down -Strict-Transport-Security
		header_down -Alt-Svc
		header_down -X-Served-By
		header_down -X-Cache
		header_down -X-Cache-Hits
		header_down -X-Timer
	}
}

{$CANTOS_THEATRE_HOST} {
	import cantos_security
	import cantos_errors
	import cantos_theatre_api
	handle {
		# A Firebase email action opens this origin with a one-time `oobCode` in the query. The
		# page reads it in the browser; the static origin never needs it. The response is never
		# cached or sent as a Referer, and the code is removed from the upstream request so it
		# reaches neither Firebase Hosting nor any log that records the upstream URL.
		@action_code query oobCode=*
		route {
			header @action_code >Cache-Control "no-store"
			header @action_code >Referrer-Policy "no-referrer"
			uri @action_code query -oobCode
			import firebase_site {$CANTOS_THEATRE_FIREBASE_SITE}
		}
	}
}

{$CANTOS_STUDIO_HOST} {
	import cantos_security
	import cantos_errors
	header X-Frame-Options DENY
	handle /api/* {
		import cantos_api cantos-api-studio
	}
	handle {
		import firebase_site {$CANTOS_STUDIO_FIREBASE_SITE}
	}
}

{$CANTOS_API_HOST} {
	import cantos_security
	import cantos_errors
	# Direct Hosting uses this API ingress; each group retains its own origin-pinned process.
	handle /api/v1/studio/* {
		import cantos_api cantos-api-studio
	}
	import cantos_theatre_api
	handle {
		respond "Cantos API" 404
	}
}

{$CANTOS_IDM_HOST} {
	import cantos_security
	# The sign-in pages, OIDC endpoints and credential-reset links must be public, but Kanidm's
	# management REST API is not a browser surface: person/group/OAuth2-client administration and
	# credential-reset intent creation. Only the private container network (the Cantos APIs and
	# the operator CLI, which reach this host through the edge alias) may call it. `remote_ip`
	# is the TCP peer and cannot be set by a header. Override the default RFC 1918/loopback set
	# with CANTOS_INTERNAL_CIDRS in edge.env when the private network is narrower.
	@kanidm_admin {
		path /v1/person /v1/person/* /v1/service_account /v1/service_account/*
		path /v1/group /v1/group/* /v1/oauth2 /v1/oauth2/* /v1/system /v1/system/*
		path /v1/domain /v1/domain/* /v1/schema /v1/schema/* /v1/raw/* /v1/recycle_bin/*
		path /v1/sync_account /v1/sync_account/* /v1/application /v1/application/*
		path /v1/client_certificate /v1/client_certificate/*
		not remote_ip {$CANTOS_INTERNAL_CIDRS:private_ranges}
	}
	respond @kanidm_admin 404
	# Kanidm serves TLS itself with a certificate from the host's private CA.
	reverse_proxy https://cantos-kanidm:8443 {
		transport http {
			tls_trust_pool file /etc/caddy/internal-ca.pem
			tls_server_name cantos-kanidm
		}
	}
}
