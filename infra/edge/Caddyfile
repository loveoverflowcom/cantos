# Public HTTPS edge for the Cantos VPS (ADR 0039). Caddy obtains and renews one Let's Encrypt
# certificate per host (HTTP-01 on port 80), so DNS must already point at this machine;
# DuckDNS resolves every subdomain of `cantoss` to the same address.
#
#   {$CANTOS_THEATRE_HOST}  Cantos Theatre Web (listeners) + its /api/*
#   {$CANTOS_STUDIO_HOST}   Cantos Studio Web (creators)   + its /api/*
#   {$CANTOS_API_HOST}      Cantos API for non-browser clients (native apps, producers)
#   {$CANTOS_IDM_HOST}      Kanidm sign-in pages and OIDC endpoints
#
# Every value comes from /root/cantos-services/config/edge.env; nothing here names a project.
#
# This file retains ADR 0039's transitional Web/identity proxies. ADR 0041 selects direct
# Firebase Hosting with explicit client API origin and exact-origin API CORS. Installed files
# do not change with source; reconcile through the current production runbook before rollout.
# Theatre and Studio keep independent origin-pinned API processes and permission boundaries.
# Transitional static upstreams use verified Firebase Site IDs, never domains or URLs;
# changing their EnvironmentFile requires an explicitly authorized edge restart.

{
	# The admin API stays inside the container; reloads use `caddy reload` there.
	admin localhost:2019
}

# `?` sets a default only: the API's stricter `Referrer-Policy: no-referrer` must survive.
(cantos_security) {
	header {
		?X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# An absent or unhealthy upstream is a dial error (502/504), reported as an honest 503.
(cantos_errors) {
	handle_errors 502 503 504 {
		@api path /api/*
		handle @api {
			header Content-Type application/json
			header Retry-After 60
			respond `{"error":"api_unavailable"}` 503
		}
		handle {
			header Content-Type "text/plain; charset=utf-8"
			header Retry-After 60
			respond "Cantos is temporarily unavailable." 503
		}
	}
}

# One API process per Web origin. JSON is compressed here; the API owns Cache-Control.
# X-Forwarded-For is *replaced* with the TCP peer Caddy actually saw, never appended to a
# client-supplied value, so the API can read it as the client address when (and only when) it
# is configured with this container network as its trusted proxy
# (CANTOS_THEATRE_REGISTRATION_PEER_POLICY=trusted_proxy, see docs/deployment/vps-production.md).
# `Forwarded` and `X-Real-IP` are dropped because the API gives them no meaning.
(cantos_api) {
	encode zstd gzip
	reverse_proxy {args[0]}:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up -Forwarded
		header_up -X-Real-IP
	}
}

# Theatre API routes. Anonymous registration bodies are tiny; the API enforces its own 8 KiB
# limit and this rejects larger bodies at the edge before they reach the process.
(cantos_theatre_api) {
	handle /api/v1/theatre/auth/registration* {
		request_body {
			max_size 16KB
		}
		import cantos_api cantos-api-theatre
	}
	handle /api/* {
		import cantos_api cantos-api-theatre
	}
}

# A Firebase Hosting site as the static origin. Host must be the *.web.app name for Firebase
# routing. Its own HSTS/Alt-Svc describe web.app, not this host, so they are replaced/dropped.
(firebase_site) {
	reverse_proxy https://{args[0]}.web.app {
		header_up Host {upstream_hostport}
		header_down -Strict-Transport-Security
		header_down -Alt-Svc
		header_down -X-Served-By
		header_down -X-Cache
		header_down -X-Cache-Hits
		header_down -X-Timer
	}
}

{$CANTOS_THEATRE_HOST} {
	import cantos_security
	import cantos_errors
	import cantos_theatre_api
	handle {
		# A Firebase email action opens this origin with a one-time `oobCode` in the query. The
		# page reads it in the browser; the static origin never needs it. The response is never
		# cached or sent as a Referer, and the code is removed from the upstream request so it
		# reaches neither Firebase Hosting nor any log that records the upstream URL.
		@action_code query oobCode=*
		route {
			header @action_code >Cache-Control "no-store"
			header @action_code >Referrer-Policy "no-referrer"
			uri @action_code query -oobCode
			import firebase_site {$CANTOS_THEATRE_FIREBASE_SITE}
		}
	}
}

{$CANTOS_STUDIO_HOST} {
	import cantos_security
	import cantos_errors
	header X-Frame-Options DENY
	handle /api/* {
		import cantos_api cantos-api-studio
	}
	handle {
		import firebase_site {$CANTOS_STUDIO_FIREBASE_SITE}
	}
}

{$CANTOS_API_HOST} {$CANTOS_API_ALIAS_HOST:} {
	import cantos_security
	import cantos_errors
	# Direct Hosting uses this API ingress; each group retains its own origin-pinned process.
	handle /api/v1/studio/* {
		import cantos_api cantos-api-studio
	}
	import cantos_theatre_api
	handle {
		respond "Cantos API" 404
	}
}

# Keep the initialized authority/issuer and private-CA validation unchanged. Only this
# snippet reaches Kanidm; the identity site below admits private peers or named public routes.
(cantos_kanidm_upstream) {
	reverse_proxy https://cantos-kanidm:8443 {
		transport http {
			tls_trust_pool file /etc/caddy/internal-ca.pem
			tls_server_name cantos-kanidm
		}
	}
}

{$CANTOS_IDM_HOST} {
	import cantos_security
	header Referrer-Policy no-referrer
	# Required explicit TCP peer CIDRs, inventoried from the existing Cantos network.
	# No private_ranges default and no trust in client-supplied forwarding headers.
	@kanidm_private remote_ip {$CANTOS_INTERNAL_CIDRS}
	handle @kanidm_private {
		import cantos_kanidm_upstream
	}
	# Refuse ambiguous public path spellings before decoded/normalized matching. Query
	# encoding remains available for OIDC state/PKCE; no request URL is logged here.
	@kanidm_noncanonical expression `{http.request.orig_uri}.matches('^[^?]*%') || {http.request.orig_uri}.matches('^[^?]*//') || {http.request.orig_uri}.matches('^[^?]*/[.]{1,2}(/|[?]|$)') || {http.request.orig_uri}.matches('^[^?]*\\\\')`
	handle @kanidm_noncanonical {
		header Cache-Control no-store
		respond "Not found" 404
	}
	# Kanidm 1.10.5 source-pinned browser login, consent and existing credential setup.
	# No /ui/*, /ui/api/*, /oauth2/*, /v1/* or /pkg/* wildcard is admitted publicly.
	@kanidm_browser_get {
		method GET HEAD
		path / /ui /ui/ /ui/login /ui/login/oauth2_landing /ui/apps /ui/logout
		path /ui/login/begin /ui/login/mech_choose /ui/login/pw /ui/login/totp /ui/login/backup_code /ui/login/seckey /ui/login/passkey
		path /ui/oauth2 /ui/oauth2/resume /ui/enrol /ui/reset /ui/recover /ui/revoke /ui/update_credentials /ui/unlock
		path /ui/images/domain /ui/images/oauth2/cantos-studio-web-bff /ui/images/oauth2/cantos-theatre-web-bff
		path /manifest.webmanifest /robots.txt
		path /pkg/external/bootstrap.min.css /pkg/external/bootstrap.bundle.min.js /pkg/external/htmx.min.1.9.12.js /pkg/external/htmx_bs_validation.js /pkg/external/forms.js /pkg/external/confetti.js /pkg/external/base64.js
		path /pkg/modules/cred_update.mjs /pkg/csrf.js /pkg/pkhtml.js /pkg/style.js /pkg/style.css /pkg/override.css
		path /pkg/img/favicon.png /pkg/img/apple-touch-icon.png /pkg/img/logo.svg /pkg/img/logo-square.svg /pkg/img/logo-180.png /pkg/img/logo-192.png /pkg/img/logo-256.png /pkg/img/logo-512.png /pkg/img/kani-waving.svg
		path /pkg/img/icons/building-lock.svg /pkg/img/icons/key.svg /pkg/img/icons/person.svg /pkg/img/icons/phone-flip.svg /pkg/img/icons/shield-lock.svg /pkg/img/icons/wifi.svg
	}
	handle @kanidm_browser_get {
		import cantos_kanidm_upstream
	}
	@kanidm_browser_post {
		method POST
		path /ui/login/begin /ui/login/mech_choose /ui/login/pw /ui/login/totp /ui/login/backup_code /ui/login/seckey /ui/login/passkey
		path /ui/oauth2/consent /ui/recover /ui/revoke
		path /ui/reset/add_totp /ui/reset/add_password /ui/reset/change_password /ui/reset/add_passkey
		path /ui/api/delete_alt_creds /ui/api/add_totp /ui/api/remove_totp /ui/api/remove_passkey /ui/api/finish_passkey /ui/api/cancel_mfareg /ui/api/cu_cancel /ui/api/cu_commit
	}
	handle @kanidm_browser_post {
		import cantos_kanidm_upstream
	}
	# Discovery/key reads belong to the API's private ingress, like exchange/userinfo/
	# introspection/revocation and every management operation. Unlisted methods fail here.
	handle {
		header Cache-Control no-store
		respond "Not found" 404
	}
}
