{
  "tool_surface_version": "cantos-adaptation-tools-1",
  "transport": "cli_over_authenticated_http",
  "generation_owner": "caller",
  "tools": [
    {
      "name": "cantos_adaptation_context",
      "command": "context",
      "description": "Export an authenticated immutable source/revision context and output contract. This exports data only; it never invokes AI or accepts a revision.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "extractor_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "script_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "rights_authorization": {
            "const": true
          }
        },
        "required": [
          "operation_id",
          "source_id",
          "source_sha256",
          "extractor_version",
          "script_id",
          "expected_revision",
          "rights_authorization"
        ]
      }
    },
    {
      "name": "cantos_adaptation_context_read",
      "command": "context-read",
      "description": "Reopen the exact frozen context by run ID, with current authorization. No latest-source substitution.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "run_id"
        ]
      }
    },
    {
      "name": "cantos_adaptation_submit",
      "command": "submit",
      "description": "Submit caller-created untrusted proposal JSON and declared, unverified provenance. Validation persists a receipt; it never accepts or replaces a script revision.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "submission": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "context_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "proposal_json": {
                "type": "string",
                "description": "Untrusted output; empty or domain-oversized output can produce an immutable invalid receipt. The entire encoded CLI/HTTP request must fit 1 MiB; valid proposal output is further bounded to 256 KiB UTF-8."
              },
              "generation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host_tool": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "provider": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "model": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "configuration_json": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 16384
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "prompt_version": {
                    "const": "cantos-radio-adapt-1"
                  },
                  "usage": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "input_tokens": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 18446744073709551615
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "output_tokens": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 18446744073709551615
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": []
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cost": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "currency": {
                            "enum": [
                              "USD",
                              "VND"
                            ]
                          },
                          "amount_minor": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 18446744073709551615
                          },
                          "basis": {
                            "const": "caller_declared"
                          }
                        },
                        "required": [
                          "currency",
                          "amount_minor",
                          "basis"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "host_tool",
                  "prompt_version"
                ]
              }
            },
            "required": [
              "operation_id",
              "context_digest",
              "proposal_json",
              "generation"
            ]
          }
        },
        "required": [
          "run_id",
          "submission"
        ]
      }
    },
    {
      "name": "cantos_adaptation_review",
      "command": "review",
      "description": "Read the source-bound proposal, findings, submission receipt and any exact accepted revision for editorial review.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "run_id"
        ]
      }
    }
  ]
}
