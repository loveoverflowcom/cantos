{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cantos.invalid/schemas/theatre-registration-v1.schema.json",
  "title": "Theatre email onboarding public responses v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "enum": [
        "accepted",
        "setup_link_sent",
        "unavailable"
      ]
    }
  },
  "$defs": {
    "native_configuration": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "action_origin"],
          "properties": {
            "status": {"const": "firebase_email_verification"},
            "action_origin": {"type": "string"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "unavailable"}}
        }
      ]
    },
    "accepted": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"enum": ["accepted"], "type": "string"}}
    },
    "email_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string"
        }
      }
    },
    "proof_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "type": "string"
        }
      }
    },
    "firebase_confirm_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "oob_code"
      ],
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "oob_code": {
          "type": "string"
        }
      }
    },
    "firebase_confirmation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "login",
            "setup_url"
          ],
          "properties": {
            "status": {
              "const": "setup_ready"
            },
            "login": {
              "type": "string"
            },
            "setup_url": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        }
      ]
    }
  }
}
