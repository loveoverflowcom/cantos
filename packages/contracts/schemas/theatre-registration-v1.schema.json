{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cantos.invalid/schemas/theatre-registration-v1.schema.json",
  "title": "Theatre email onboarding public responses v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "enum": [
        "accepted",
        "setup_link_sent",
        "unavailable"
      ]
    }
  },
  "$defs": {
    "email_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string"
        }
      }
    },
    "proof_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "type": "string"
        }
      }
    }
  }
}
