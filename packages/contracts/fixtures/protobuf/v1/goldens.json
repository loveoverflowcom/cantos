      "value": {
        "script_json": "{\n  \"schema_version\": \"0.1.0\",\n  \"work\": {\n    \"id\": \"work-demo\",\n    \"title\": \"Ánh đèn cuối sân khấu\",\n    \"rights_record_id\": \"rights-demo\",\n    \"source_ref\": \"origin-demo\"\n  },\n  \"adaptation\": {\n    \"id\": \"adaptation-demo\",\n    \"language\": \"vi-VN\",\n    \"rights_record_id\": \"rights-adaptation-demo\",\n    \"provenance_refs\": [\n      \"origin-demo\"\n    ]\n  },\n  \"characters\": [\n    {\n      \"id\": \"narrator\",\n      \"name\": \"Người dẫn chuyện\",\n      \"role\": \"narrator\",\n      \"personality\": \"Calm and observant\"\n    },\n    {\n      \"id\": \"an\",\n      \"name\": \"An\",\n      \"role\": \"character\",\n      \"personality\": \"Curious and hopeful\"\n    },\n    {\n      \"id\": \"minh\",\n      \"name\": \"Minh\",\n      \"role\": \"character\",\n      \"personality\": \"Reserved but warm\"\n    }\n  ],\n  \"episode\": {\n    \"id\": \"episode-demo-01\",\n    \"title\": \"Một lời hẹn\",\n    \"acts\": [\n      {\n        \"id\": \"act-01\",\n        \"title\": \"Sân khấu trống\",\n        \"scenes\": [\n          {\n            \"id\": \"scene-01\",\n            \"title\": \"Sau buổi diễn\",\n            \"dialogues\": [\n              {\n                \"id\": \"dialogue-01\",\n                \"speaker_id\": \"narrator\",\n                \"text\": \"“Đi thôi!” — anh nói \\\"khẽ\\\"; lối C:\\\\kịch\\\\cảnh-1 🎭 Ngày mai…\",\n                \"delivery\": {\n                  \"emotion\": \"calm\",\n                  \"intensity_permille\": 300\n                },\n                \"pronunciation_overrides\": []\n              },\n              {\n                \"id\": \"dialogue-02\",\n                \"speaker_id\": \"an\",\n                \"text\": \"Ngày mai, mình có diễn tiếp không?\",\n                \"delivery\": {\n                  \"emotion\": \"hopeful\",\n                  \"intensity_permille\": 600\n                },\n                \"pronunciation_overrides\": []\n              },\n              {\n                \"id\": \"dialogue-03\",\n                \"speaker_id\": \"minh\",\n                \"text\": \"Có chứ. Tôi sẽ chờ cậu ở đây.\",\n                \"delivery\": {\n                  \"emotion\": \"warm\",\n                  \"intensity_permille\": 400\n                },\n                \"pronunciation_overrides\": []\n              }\n            ],\n            \"sound_cues\": [\n              {\n                \"id\": \"cue-01\",\n                \"kind\": \"ambience\",\n                \"description\": \"Quiet theatre room tone\",\n                \"anchor\": {\n                  \"dialogue_id\": \"dialogue-01\",\n                  \"edge\": \"start\"\n                }\n              }\n            ]\n          },\n          {\n            \"id\": \"scene-02\",\n            \"title\": \"Bên cửa sổ\",\n            \"dialogues\": [\n              {\n                \"id\": \"dialogue-04\",\n                \"speaker_id\": \"an\",\n                \"text\": \"Vọng Đài vẫn sáng… Hẹn gặp lại!\",\n                \"delivery\": {\n                  \"emotion\": \"warm\",\n                  \"intensity_permille\": 400\n                },\n                \"pronunciation_overrides\": [\n                  {\n                    \"surface\": \"Vọng Đài\",\n                    \"replacement\": \"Vọng Đài\"\n                  }\n                ]\n              }\n            ],\n            \"sound_cues\": [\n              {\n                \"id\": \"cue-02\",\n                \"kind\": \"sfx\",\n                \"description\": \"Tiếng cửa khép nhẹ\",\n                \"anchor\": {\n                  \"dialogue_id\": \"dialogue-04\",\n                  \"edge\": \"end\"\n                },\n                \"asset\": {\n                  \"id\": \"asset-demo\",\n                  \"rights_record_id\": \"rights-asset-demo\"\n                }\n              }\n            ]\n          }\n        ]\n      }\n    ]\n  },\n  \"provenance\": [\n    {\n      \"id\": \"origin-demo\",\n      \"kind\": \"original\",\n      \"source_record_id\": \"source-demo\",\n      \"rights_record_id\": \"rights-demo\"\n    }\n  ]\n}\n"
      },
