:where(.cantos-ui) .cui-select-option[aria-selected="true"] .cui-select-option-check {
  visibility: visible;
}
:where(.cantos-ui) .cui-select-option[aria-disabled="false"]:hover {
  background-image: linear-gradient(color-mix(in srgb, currentColor calc(var(--cantos-state-hover-opacity) * 100%), transparent), color-mix(in srgb, currentColor calc(var(--cantos-state-hover-opacity) * 100%), transparent));
}
:where(.cantos-ui) .cui-select-option[data-active="true"] {
  outline: var(--cantos-size-border) solid var(--cantos-color-focus);
  outline-offset: calc(-1 * var(--cantos-size-border));
}
:where(.cantos-ui) .cui-select-option[aria-disabled="true"] {
  color: var(--cantos-color-on-surface-variant);
  cursor: default;
}
@media (forced-colors: active) {
  :where(.cantos-ui) .cui-select-option[aria-selected="true"] {
    border-color: Highlight;
  }
  :where(.cantos-ui) .cui-select-option[data-active="true"] {
    outline-color: Highlight;
  }
  :where(.cantos-ui) .cui-select-option[aria-disabled="true"] { color: GrayText; }
}
:where(.cantos-ui) .cui-textarea {
  resize: vertical;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
:where(.cantos-ui) .cui-field:not([data-variant="floating"]) .cui-field-control[readonly] {
  background: var(--cantos-color-surface-container);
}
:where(.cantos-ui) .cui-field:not([data-variant="floating"]) .cui-field-control:disabled {
  color: var(--cantos-color-on-surface-variant);
  background: var(--cantos-color-surface-container);
  opacity: 1;
  cursor: default;
}
:where(.cantos-ui) .cui-field:not([data-variant="floating"]) .cui-field-control[aria-invalid="true"] {
  background: var(--cantos-color-error-container);
}
/* One state perimeter per control, never a bottom bar or an outset ring: the stroke is an outline
   pulled inside the control's own painted bounds (the compact Select reaches its 40-unit surface
   through --cantos-web-stroke-inset). Invalid is 1; focus and an open Select are 2, in the error
   color when invalid. The outline follows the corner radius and survives forced colors. */
:where(.cantos-ui) .cui-field-control {
  --cantos-web-stroke-inset: 0px;
}
:where(.cantos-ui) .cui-field-control[aria-invalid="true"] {
  outline: var(--cantos-web-stroke-rest) solid var(--cantos-color-error);
  outline-offset: calc(-1 * (var(--cantos-web-stroke-inset) + var(--cantos-web-stroke-rest)));
}
:where(.cantos-ui) .cui-field-control:is(:focus-visible, [aria-expanded="true"]) {
  outline: var(--cantos-web-stroke-active) solid var(--cantos-color-focus);
  outline-offset: calc(-1 * (var(--cantos-web-stroke-inset) + var(--cantos-web-stroke-active)));
}
:where(.cantos-ui) .cui-field-control[aria-invalid="true"]:is(:focus-visible, [aria-expanded="true"]) {
  outline-color: var(--cantos-color-error);
}
:where(.cantos-ui) :is(.cui-choice-control, .cui-range-control):focus-visible {
  outline: var(--cantos-size-focus-width) solid var(--cantos-color-focus);
  outline-offset: var(--cantos-size-focus-offset);
}
/* Web-only candidate superseded by Floating: only the label/help spacing remains. */
:where(.cantos-ui) .cui-field[data-variant="auth-tonal-spacious"] {
  gap: var(--cantos-space-sm);
}
/* Fields v3 Floating. One shell paints the fill and the state stroke; the control inside is
   transparent and the label rests as the placeholder, then floats while the browser reports focus
   or any value (:placeholder-shown, so whitespace, composition, autofill and restored values all
   count). Grid rows replace absolute positioning: a long label or large text grows the shell and
   never clips. The label moves between rows without animation. */
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: auto 1fr;
  min-inline-size: 0;
  min-block-size: var(--cantos-web-field-block-size);
  border-radius: var(--cantos-web-field-radius);
  background: var(--cantos-color-surface-container-high);
  color: var(--cantos-color-on-surface);
  cursor: text;
  transition: background-color var(--cantos-motion-feedback-duration) var(--cantos-motion-effects-easing);
}
:where(.cantos-ui) .cui-field[data-variant="floating"][data-state="editable"] .cui-field-shell:hover {
  background: color-mix(in srgb, var(--cantos-color-on-surface) calc(var(--cantos-state-hover-opacity) * 100%), var(--cantos-color-surface-container-high));
}
:where(.cantos-ui) .cui-field[data-variant="floating"]:is([data-state="readonly"], [data-state="disabled"], [data-state="loading"]) .cui-field-shell {
  background: var(--cantos-color-surface-container);
}
:where(.cantos-ui) .cui-field[data-variant="floating"]:is([data-state="disabled"], [data-state="loading"]) .cui-field-shell {
  color: var(--cantos-color-on-surface-variant);
  cursor: default;
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell > .cui-field-control {
  grid-column: 1;
  grid-row: 2;
  min-block-size: 0;
  padding: var(--cantos-web-field-label-gap) var(--cantos-web-field-inset) var(--cantos-web-field-value-bottom);
  border-radius: inherit;
  background: transparent;
  color: inherit;
  line-height: 1.5rem;
  outline: none;
  cursor: inherit;
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell > .cui-field-control::placeholder {
  color: var(--cantos-color-on-surface-variant);
  opacity: 0;
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell > .cui-field-control:focus::placeholder {
  opacity: 1;
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell > .cui-field-label {
  grid-column: 1;
  grid-row: 1;
  align-self: start;
  padding: var(--cantos-web-field-label-top) var(--cantos-web-field-inset) 0;
  color: var(--cantos-color-on-surface-variant);
  font-size: var(--cantos-type-metadata-size);
  line-height: var(--cantos-type-metadata-line-height);
  font-weight: var(--cantos-type-label-weight);
  overflow-wrap: anywhere;
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell > .cui-field-control:placeholder-shown:not(:focus) ~ .cui-field-label {
  grid-row: 1 / -1;
  align-self: center;
  padding-block: var(--cantos-web-field-label-top);
  font-size: var(--cantos-type-body-size);
  line-height: 1.5rem;
  font-weight: var(--cantos-type-body-weight);
}
/* Autofill paints its own fill and may precede any input event: keep the shell's tone, the
   floated label and the value color. Each vendor selector stays in its own rule so an engine
   that lacks one drops only that rule. */
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell > .cui-field-control:-webkit-autofill {
  -webkit-text-fill-color: var(--cantos-color-on-surface);
  transition: background-color 600000s 0s, color 600000s 0s;
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell > .cui-field-control.cui-field-control:-webkit-autofill ~ .cui-field-label {
  grid-row: 1;
  align-self: start;
  padding: var(--cantos-web-field-label-top) var(--cantos-web-field-inset) 0;
  font-size: var(--cantos-type-metadata-size);
  line-height: var(--cantos-type-metadata-line-height);
  font-weight: var(--cantos-type-label-weight);
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell > .cui-field-control.cui-field-control:autofill ~ .cui-field-label {
  grid-row: 1;
  align-self: start;
  padding: var(--cantos-web-field-label-top) var(--cantos-web-field-inset) 0;
  font-size: var(--cantos-type-metadata-size);
  line-height: var(--cantos-type-metadata-line-height);
  font-weight: var(--cantos-type-label-weight);
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell[data-invalid="true"] {
  outline: var(--cantos-web-stroke-rest) solid var(--cantos-color-error);
  outline-offset: calc(-1 * var(--cantos-web-stroke-rest));
}
/* The perimeter follows the field's own control. A trailing action inside the shell keeps its
   own focus ring, so focus-within would stack a second indicator on the shell. */
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell:has(> .cui-field-control:focus-visible) {
  outline: var(--cantos-web-stroke-active) solid var(--cantos-color-focus);
  outline-offset: calc(-1 * var(--cantos-web-stroke-active));
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell[data-invalid="true"]:has(> .cui-field-control:focus-visible) {
  outline-color: var(--cantos-color-error);
}
/* Trailing action: one native control in a second column of the same shell. The control column
   ends where the action begins, so typed text can never run under it, at any zoom. The action keeps
   its own 48-unit hit area; a blocked reason stays available to assistive technology while the
   field's own reason is the visible one. */
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell[data-trailing="true"] {
  grid-template-columns: minmax(0, 1fr) auto;
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell > .cui-field-trailing {
  grid-column: 2;
  grid-row: 1 / -1;
  align-self: center;
  display: flex;
  align-items: center;
  padding-inline-end: var(--cantos-web-field-trailing-inset);
  cursor: default;
}
:where(.cantos-ui) .cui-field-trailing .cui-button-reason:not([hidden]) {
  position: absolute;
  inline-size: 1px;
  block-size: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
:where(.cantos-ui) .cui-field-trailing .cui-icon-button[data-variant="text"] {
  color: var(--cantos-color-on-surface-variant);
}
:where(.cantos-ui) .cui-field-trailing .cui-button:focus-visible {
  outline-offset: 0;
}
:where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell[data-invalid="true"] > .cui-field-label {
  color: var(--cantos-color-error);
}
/* Supporting text sits outside and below the shell, aligned with the value. */
:where(.cantos-ui) .cui-field[data-variant="floating"] > .cui-field-help {
  padding-inline: var(--cantos-web-field-inset);
}
@media (prefers-reduced-motion: reduce) {
  :where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell { transition: none; }
}
:where(.cantos-ui) :is(.cui-field-help, .cui-field-error) {
  margin: 0;
  font-size: var(--cantos-type-metadata-size);
  line-height: var(--cantos-type-metadata-line-height);
  overflow-wrap: anywhere;
}
:where(.cantos-ui) .cui-field-help {
  color: var(--cantos-web-supporting-text-color);
}
:where(.cantos-ui) .cui-field-error {
  padding: var(--cantos-space-xs) var(--cantos-space-sm);
  border-radius: var(--cantos-web-shape-reading);
  color: var(--cantos-color-error);
  background: var(--cantos-color-error-container);
}
:where(.cantos-ui) :is(.cui-field-help, .cui-field-error)[hidden] { display: none; }
/* The associated native label enlarges the click/touch area without enlarging the glyph. */
:where(.cantos-ui) .cui-choice-label {
  display: flex;
  align-items: center;
  gap: var(--cantos-space-sm);
  min-block-size: var(--cantos-size-control);
  min-inline-size: var(--cantos-size-control);
  cursor: pointer;
}
:where(.cantos-ui) .cui-choice-control {
  flex: 0 0 auto;
  margin: 0;
  inline-size: var(--cantos-size-icon-compact);
  block-size: var(--cantos-size-icon-compact);
  accent-color: var(--cantos-color-primary);
  cursor: inherit;
}
:where(.cantos-ui) .cui-choice[data-state="disabled"] .cui-choice-label,
:where(.cantos-ui) .cui-choice[data-state="loading"] .cui-choice-label {
  cursor: default;
}
:where(.cantos-ui) .cui-choice-control[role="switch"] {
  appearance: none;
  position: relative;
  box-sizing: border-box;
  inline-size: var(--cantos-size-control);
  block-size: var(--cantos-size-icon);
  border: var(--cantos-size-border) solid var(--cantos-color-outline);
  border-radius: var(--cantos-shape-pill);
  background: var(--cantos-color-surface-container);
}
:where(.cantos-ui) .cui-choice-control[role="switch"]::before {
  content: "";
  position: absolute;
  inset-block-start: calc((var(--cantos-size-icon) - var(--cantos-size-icon-compact)) / 2 - var(--cantos-size-border));
  inset-inline-start: calc((var(--cantos-size-icon) - var(--cantos-size-icon-compact)) / 2 - var(--cantos-size-border));
  inline-size: var(--cantos-size-icon-compact);
  block-size: var(--cantos-size-icon-compact);
  border-radius: var(--cantos-shape-pill);
  background: var(--cantos-color-on-surface-variant);
}
:where(.cantos-ui) .cui-choice-control[role="switch"]:checked {
  background: var(--cantos-color-primary);
  border-color: var(--cantos-color-primary);
}
:where(.cantos-ui) .cui-choice-control[role="switch"]:checked::before {
  inset-inline-start: calc(var(--cantos-size-control) - var(--cantos-size-icon-compact) - (var(--cantos-size-icon) - var(--cantos-size-icon-compact)) / 2 - var(--cantos-size-border));
  background: var(--cantos-color-on-primary);
}
:where(.cantos-ui) .cui-choice-control[role="switch"]:disabled {
  background: var(--cantos-color-surface-container);
  border-color: var(--cantos-color-outline);
}
:where(.cantos-ui) .cui-choice-control[role="switch"]:disabled::before {
  background: var(--cantos-color-on-surface-variant);
}
:where(.cantos-ui) .cui-range-control {
  box-sizing: border-box;
  inline-size: 100%;
  min-inline-size: 0;
  min-block-size: var(--cantos-size-control);
  margin: 0;
  accent-color: var(--cantos-color-primary);
}
/* No continuous motion or custom range keyboard logic; native controls own these interactions. */
@media (forced-colors: active) {
  :where(.cantos-ui) .cui-field-control { border: var(--cantos-size-border) solid FieldText; }
  :where(.cantos-ui) .cui-field-control[aria-invalid="true"]:not(:focus-visible):not([aria-expanded="true"]) { outline-style: dashed; }
  :where(.cantos-ui) .cui-field-control:disabled { color: GrayText; }
  :where(.cantos-ui) .cui-field-control:is(:focus-visible, [aria-expanded="true"]) { outline-color: Highlight; }
  :where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell { border: var(--cantos-size-border) solid FieldText; }
  :where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell > .cui-field-control { border: 0; }
  :where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell[data-invalid="true"]:not(:has(> .cui-field-control:focus-visible)) { outline-style: dashed; }
  :where(.cantos-ui) .cui-field[data-variant="floating"] .cui-field-shell:has(> .cui-field-control:focus-visible) { outline-color: Highlight; }
  :where(.cantos-ui) .cui-field[data-variant="floating"]:is([data-state="disabled"], [data-state="loading"]) .cui-field-shell { border-color: GrayText; }
  :where(.cantos-ui) .cui-select-menu { border: var(--cantos-size-border) solid CanvasText; }
  :where(.cantos-ui) .cui-choice-control[role="switch"] { border-color: ButtonText; }
  :where(.cantos-ui) .cui-choice-control[role="switch"]::before { background: ButtonText; }
  :where(.cantos-ui) .cui-choice-control[role="switch"]:checked { background: Highlight; }
  :where(.cantos-ui) .cui-choice-control[role="switch"]:checked::before { background: HighlightText; }
  :where(.cantos-ui) .cui-choice-control[role="switch"]:disabled::before { background: GrayText; }
}

/* Native dialog owns top-layer containment; no scripted motion or background dismissal. */
:where(.cantos-ui) .cui-dialog {
  box-sizing: border-box;
  inline-size: min(35rem, calc(100% - 2 * var(--cantos-space-md)));
  max-inline-size: calc(100% - 2 * var(--cantos-space-md));
  max-block-size: calc(100dvh - 2 * var(--cantos-space-md));
  margin: auto;
  padding: var(--cantos-space-md);
  border: 0;
  border-radius: var(--cantos-web-shape-overlay);
  background: var(--cantos-color-surface);
  color: var(--cantos-color-on-surface);
  font-family: var(--cantos-type-family-ui);
  font-size: var(--cantos-type-body-size);
  line-height: var(--cantos-type-body-line-height);
  box-shadow: var(--cantos-elevation-overlay);
  overflow-wrap: anywhere;
}
:where(.cantos-ui) .cui-dialog[open] {
  display: flex;
  flex-direction: column;
  gap: var(--cantos-space-md);
}
:where(.cantos-ui) .cui-dialog::backdrop {
  background: color-mix(in srgb, var(--cantos-color-primary) 32%, transparent);
}
:where(.cantos-ui) .cui-dialog-header {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: var(--cantos-space-sm);
  min-inline-size: 0;
  flex-shrink: 0;
}
:where(.cantos-ui) .cui-dialog-title {
  flex: 1 1 12rem;
  min-inline-size: 0;
  margin: 0;
  font-family: var(--cantos-type-family-editorial);
  font-size: var(--cantos-type-title-size);
  line-height: var(--cantos-type-title-line-height);
  font-weight: var(--cantos-type-title-weight);
}
:where(.cantos-ui) .cui-dialog-close {
  flex: 0 1 auto;
  margin-inline-start: auto;
}
:where(.cantos-ui) .cui-dialog-description {
  margin: 0 0 var(--cantos-space-md);
  color: var(--cantos-color-on-surface-variant);
}
:where(.cantos-ui) .cui-dialog-body {
  flex: 1 1 auto;
  min-inline-size: 0;
  min-block-size: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: calc(var(--cantos-size-focus-width) + var(--cantos-size-focus-offset));
  /* Keep focus room inside the content box. Negative margins produce horizontal
     scrollable overflow in Safari's native dialog even when all text fits. */
}
:where(.cantos-ui) .cui-dialog-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: var(--cantos-space-sm);
  min-inline-size: 0;
  flex-shrink: 0;
}
@media (min-width: {{breakpoint.medium}}) {
  :where(.cantos-ui) .cui-dialog { padding: var(--cantos-space-lg); }
}
@media (forced-colors: active) {
  :where(.cantos-ui) .cui-dialog { border: var(--cantos-size-border) solid CanvasText; }
}

/* Development gallery only; product pane/navigation rules belong to their apps. */
:where(.cantos-ui) .cui-preview {
  max-inline-size: none;
  min-block-size: 100vh;
  padding-block: var(--cantos-space-lg);
  padding-inline: 0;
}
:where(.cantos-ui) .cui-gallery-page :where(h1, h2, h3, p) {
  margin-block: 0;
  overflow-wrap: anywhere;
}
:where(.cantos-ui) .cui-gallery-header {
  display: grid;
  gap: var(--cantos-space-sm);
}
:where(.cantos-ui) .cui-gallery-eyebrow {
  color: var(--cantos-color-on-surface-variant);
  font-size: var(--cantos-type-metadata-size);
  font-weight: var(--cantos-type-label-weight);
}
:where(.cantos-ui) .cui-gallery-page h2 {
  font-size: var(--cantos-type-title-size);
  line-height: var(--cantos-type-title-line-height);
  font-weight: var(--cantos-type-title-weight);
}
:where(.cantos-ui) .cui-gallery-page h3 {
  font-size: var(--cantos-type-body-size);
  line-height: var(--cantos-type-body-line-height);
  font-weight: var(--cantos-type-label-weight);
}
:where(.cantos-ui) .cui-gallery-note {
  color: var(--cantos-color-on-surface-variant);
  font-size: var(--cantos-type-metadata-size);
  line-height: var(--cantos-type-metadata-line-height);
}
:where(.cantos-ui) .cui-gallery-output {
  display: block;
  min-inline-size: 0;
  max-inline-size: 100%;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: var(--cantos-type-metadata-size);
  line-height: var(--cantos-type-metadata-line-height);
}
:where(.cantos-ui) .cui-gallery-fieldset {
  min-inline-size: 0;
  margin: 0;
  padding: 0;
  border: 0;
}
:where(.cantos-ui) .cui-gallery-fieldset legend {
  margin-block-end: var(--cantos-space-sm);
  padding: 0;
  font-weight: var(--cantos-type-label-weight);
}
:where(.cantos-ui) .cui-gallery-icons > span {
  display: inline-flex;
  align-items: center;
  gap: var(--cantos-space-xs);
  padding: var(--cantos-space-xs) var(--cantos-space-sm);
  background: var(--cantos-color-surface-container);
  border-radius: var(--cantos-web-shape-reading);
}
:where(.cantos-ui) .cui-gallery-page article {
  display: grid;
  gap: var(--cantos-space-md);
}
:where(.cantos-ui) .cui-gallery-page footer {
  display: grid;
  justify-items: start;
  gap: var(--cantos-space-sm);
}
:where(.cantos-ui) :where(#gallery-actions, #gallery-fields, #gallery-feedback, #gallery-layout) {
  scroll-margin-block-start: var(--cantos-space-lg);
}
:where(.cantos-ui) .cui-gallery-page .cui-surface > p + p { margin-block-start: var(--cantos-space-sm); }

/* Official SVG lockups retain their natural viewBox ratio and transparent negative space. */
:where(.cantos-ui) .cui-logo {
  display: block;
  max-inline-size: 100%;
  block-size: auto;
  object-fit: contain;
  flex-shrink: 0;
}

/* Scoped Design v2 type roles, independent from regular reader/editor headings. */
.cantos-ui .cui-auth-heading {
  font-family: var(--cantos-type-family-editorial);
  font-size: var(--cantos-type-auth-heading-size);
  font-weight: var(--cantos-type-auth-heading-weight);
  line-height: var(--cantos-type-auth-heading-line-height);
}
.cantos-ui .cui-membership-heading {
  font-family: var(--cantos-type-family-editorial);
  font-size: var(--cantos-type-membership-title-size);
  font-weight: var(--cantos-type-membership-title-weight);
  line-height: var(--cantos-type-membership-title-line-height);
}

/* Preview-only auth recipe: tonal focus and error retain the Floating anatomy. Forced colors
   retain the system border and focus indicator above until accessible runtime qualification. */
@media not (forced-colors: active) {
  :where(.cantos-ui) .cui-field[data-recipe="auth-tonal"][data-recipe="auth-tonal"] .cui-field-shell[data-invalid="true"],
  :where(.cantos-ui) .cui-field[data-recipe="auth-tonal"][data-recipe="auth-tonal"] .cui-field-shell:has(> .cui-field-control:focus-visible),
  :where(.cantos-ui) .cui-field[data-recipe="auth-tonal"][data-recipe="auth-tonal"] .cui-field-shell[data-invalid="true"]:has(> .cui-field-control:focus-visible) {
    outline: none;
  }
  :where(.cantos-ui) .cui-field[data-recipe="auth-tonal"][data-recipe="auth-tonal"] .cui-field-shell:has(> .cui-field-control:focus) {
    background: color-mix(in srgb, var(--cantos-color-primary) calc(var(--cantos-state-focus-opacity) * 100%), var(--cantos-color-surface-container-high));
  }
  :where(.cantos-ui) .cui-field[data-recipe="auth-tonal"][data-recipe="auth-tonal"] .cui-field-shell:has(> .cui-field-control:focus) > .cui-field-label {
    color: var(--cantos-color-primary);
  }
  :where(.cantos-ui) .cui-field[data-recipe="auth-tonal"][data-recipe="auth-tonal"] .cui-field-shell[data-invalid="true"][data-invalid="true"] {
    background: var(--cantos-color-error-container);
  }
  :where(.cantos-ui) .cui-field[data-recipe="auth-tonal"][data-recipe="auth-tonal"] .cui-field-shell[data-invalid="true"]:has(> .cui-field-control:focus) {
    background: color-mix(in srgb, var(--cantos-color-error) calc(var(--cantos-state-focus-opacity) * 100%), var(--cantos-color-error-container));
  }
  :where(.cantos-ui) .cui-field[data-recipe="auth-tonal"][data-recipe="auth-tonal"] .cui-field-shell[data-invalid="true"] > .cui-field-label,
  :where(.cantos-ui) .cui-field[data-recipe="auth-tonal"][data-recipe="auth-tonal"] .cui-field-shell[data-invalid="true"]:has(> .cui-field-control:focus) > .cui-field-label {
    color: var(--cantos-color-error);
  }
}
:where(.cantos-ui) .cui-field[data-recipe="auth-tonal"][data-recipe="auth-tonal"] > .cui-field-error svg {
  inline-size: 1em;
  block-size: 1em;
  vertical-align: -0.15em;
  margin-inline-end: var(--cantos-space-xs);
}
/* Compact Floating field (#559). A dense authenticated form cannot afford the 68-unit expression
   minimum on every row, so a field may ask for the standard Floating geometry (the values declared
   at the top of this file) while the expression keeps its palette, weights and corner radius. It
   still clears the 48-unit target; text, labels and zoom grow it, and nothing clips. The docked
   search keeps its own header geometry. */
:where(.cantos-ui) .cui-field[data-variant="floating"][data-field-density="compact"]:not([data-kind="search"]) {
  --cantos-web-field-block-size: 3.625rem;
  --cantos-web-field-label-top: 0.5rem;
  --cantos-web-field-value-bottom: 0.375rem;
}
/* Issue 595: a scoped Work hero. Same Button/state/intent; regular, auth and compact controls
   keep their existing anatomy. The stable well also hosts the shared MicroArc while resolving. */
:where(.cantos-ui) .cui-button[data-variant="listen-hero"] {
  display: inline-grid;
  grid-template-columns: var(--cantos-size-listen-icon-well) minmax(0, 1fr);
  gap: var(--cantos-space-inset);
  min-block-size: var(--cantos-size-listen-hero);
  min-inline-size: min(100%, var(--cantos-size-listen-hero-inline));
  border-radius: var(--cantos-shape-pill);
  padding-inline: var(--cantos-space-listen-hero-start) var(--cantos-space-section);
  font-size: var(--cantos-type-listen-hero-size);
  line-height: var(--cantos-type-listen-hero-line-height);
  font-weight: var(--cantos-type-listen-hero-weight);
}
:where(.cantos-ui) .cui-button[data-variant="listen-hero"] .cui-button-icon {
  inline-size: var(--cantos-size-listen-icon-well);
  block-size: var(--cantos-size-listen-icon-well);
  border-radius: var(--cantos-shape-pill);
  background: color-mix(in srgb, currentColor calc(var(--cantos-state-focus-opacity) * 100%), transparent);
}
:where(.cantos-ui) .cui-button[data-variant="listen-hero"] .cui-control-label {
  text-align: center;
}
:where(.cantos-ui) .cui-button[data-variant="listen-hero"][aria-disabled="true"] {
  background: var(--cantos-color-surface-container);
  color: var(--cantos-color-on-surface-variant);
  background-image: none;
  cursor: default;
  transition: none;
}
:where(.cantos-ui) .cui-button[data-variant="listen-hero"]:focus-visible {
  outline: var(--cantos-size-focus-width) solid var(--cantos-color-focus);
  outline-offset: var(--cantos-size-focus-offset);
}

/* Theatre expression. Palette and weights arrive from the canonical expression remap in
   tokens.css; only renderer-local geometry lives here, scoped to data-expression="theatre" so a
   consumer that names no expression keeps every value above. Heights are minimums: text,
   labels and zoom grow them, and nothing clips. Web CSS pixels are not Android dp. */
:where(.cantos-ui)[data-expression="theatre"] {
  --cantos-web-field-block-size: 4.25rem;
  --cantos-web-field-radius: 1rem;
  --cantos-web-field-label-top: 0.75rem;
  --cantos-web-field-value-bottom: 0.75rem;
  --cantos-web-field-trailing-inset: 0.5rem;
}
/* A search field is the docked search header (v4.3): at least 72 high with its action docked
   inside (a 52-unit visible action, at least 48 to touch) and a larger inline inset so the rounded
   end never crowds the text. The resting radius is half the header; a taller, text-scaled header
   keeps it instead of turning into a capsule. */
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-kind="search"] {
  --cantos-web-field-block-size: var(--cantos-size-search-header);
  --cantos-web-field-radius: var(--cantos-shape-search-rest);
  --cantos-web-field-inset: 1.5rem;
  --cantos-web-field-trailing-inset: 0.625rem;
}
/* No floating label: the label is the field's accessible name and, while the field is empty, the
   visible prompt in the value's place (focused or not). Once there is a value it is visually
   hidden, never removed, so the value is vertically centered and nothing moves or overlaps. */
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"][data-kind="search"] .cui-field-shell > .cui-field-label {
  position: absolute;
  inline-size: 1px;
  block-size: 1px;
  padding: 0;
  margin: -1px;
  clip-path: inset(50%);
  white-space: nowrap;
}
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"][data-kind="search"] .cui-field-shell > .cui-field-control:placeholder-shown ~ .cui-field-label {
  position: static;
  inline-size: auto;
  block-size: auto;
  margin: 0;
  clip-path: none;
  white-space: normal;
  grid-row: 1;
  align-self: center;
  padding: var(--cantos-web-field-label-top) var(--cantos-web-field-inset);
  font-size: var(--cantos-type-body-size);
  line-height: 1.5rem;
  font-weight: var(--cantos-type-body-weight);
  pointer-events: none;
}
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"][data-kind="search"] .cui-field-shell > .cui-field-control {
  padding-block: var(--cantos-web-field-label-top);
}
/* State stroke on the search shell's own bounds, like focus and invalid: idle 0, hover 1 inset,
   focus 2 inset (the shared floating rule). Hover yields to focus and invalid. */
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"][data-kind="search"][data-state="editable"] .cui-field-shell:hover:not([data-invalid="true"]):not(:has(> .cui-field-control:focus-visible)) {
  outline: var(--cantos-web-stroke-rest) solid var(--cantos-color-outline);
  outline-offset: calc(-1 * var(--cantos-web-stroke-rest));
}
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-kind="search"] .cui-field-trailing .cui-button {
  min-inline-size: var(--cantos-size-search-action);
  min-block-size: var(--cantos-size-search-action);
  padding: 0;
  border-radius: var(--cantos-shape-pill);
}
/* A borderless tonal capsule: selection reads by tone + check, never a stroke and never a shape
   change. primaryContainer is the ink of selection in this expression, so the chosen tone comes from
   the stronger tonal surface role. An unselected chip is centered on its label, so the check's space
   is not reserved here (Standard still reserves it); the chip keeps its start edge and 48-unit height
   and only grows. */
:where(.cantos-ui)[data-expression="theatre"] .cui-filter-chip .cui-chip-check {
  display: none;
}
:where(.cantos-ui)[data-expression="theatre"] .cui-filter-chip:where([aria-pressed="true"], [aria-busy="true"]) .cui-chip-check {
  display: inline-flex;
}
:where(.cantos-ui)[data-expression="theatre"] .cui-filter-chip[aria-pressed="true"] {
  background: var(--cantos-color-surface-container-high);
  color: var(--cantos-color-on-surface);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-filter-chip:is(:disabled, [aria-disabled="true"]) {
  background: var(--cantos-color-surface-container);
  color: var(--cantos-color-on-surface-variant);
}
/* The utility select is one tonal pill; its value, trailing chevron and optional leading icon
   are one centered group. */
:where(.cantos-ui)[data-expression="theatre"] .cui-select-field[data-select-density="compact"] .cui-field-control {
  border-radius: var(--cantos-shape-pill);
  background-color: var(--cantos-color-surface-container);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-select-field[data-select-density="compact"] .cui-field-control:hover:not(:disabled):not([readonly]):not([aria-invalid="true"]) {
  background-color: color-mix(in srgb, var(--cantos-color-on-surface) calc(var(--cantos-state-hover-opacity) * 100%), var(--cantos-color-surface-container));
}
:where(.cantos-ui)[data-expression="theatre"] .cui-select-field[data-select-density="compact"] .cui-select-trigger {
  justify-content: center;
}
:where(.cantos-ui)[data-expression="theatre"] .cui-select-field[data-select-density="compact"] .cui-select-value {
  flex: 0 1 auto;
}
/* In this expression primaryContainer is the ink of selection (chips, the current destination), so a
   tonal action reads from the tonal surface roles instead: pale lilac with the paired ink text. A
   tonal icon action (the theme switch) is a rounded square; a docked or circular one stays a pill. */
:where(.cantos-ui)[data-expression="theatre"] .cui-button:where([data-variant="tonal"], [data-variant="auth-secondary"]):not(:disabled) {
  background-color: var(--cantos-color-surface-container-high);
  color: var(--cantos-color-on-surface);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-icon-button[data-variant="tonal"] {
  border-radius: var(--cantos-web-shape-reading);
}
/* Fields are the tonal container (the board's lilac), with the same paler fill for any state that
   is not editable; the label, value and disabled reason, not the fill alone, carry the state. */
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"] .cui-field-shell {
  background: var(--cantos-color-surface-container);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"][data-state="editable"]:not([data-recipe="auth-tonal"]) .cui-field-shell:hover {
  background: color-mix(in srgb, var(--cantos-color-on-surface) calc(var(--cantos-state-hover-opacity) * 100%), var(--cantos-color-surface-container));
}
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"]:is([data-state="readonly"], [data-state="disabled"], [data-state="loading"]) .cui-field-shell {
  background: color-mix(in srgb, var(--cantos-color-surface-container) 50%, var(--cantos-color-surface));
}
/* The invalid cue is the stroke and the error-colored label; the message below is plain text on
   the page, not a second tinted block. */
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"] > .cui-field-error {
  padding: 0 var(--cantos-web-field-inset);
  background: transparent;
}
/* Guest card actions (design v4.3, #526). Inside the profile card (PrimaryContainer + Profile) the
   sign-in action is the contextual pink/raspberry role and create-account the card's inverse pair:
   a filled pill with the card's own foreground as fill and its container as ink. Both share one
   full-width, equal-height anatomy with no default border or shadow. Roles come from the themed
   `theatreProfileAction*` tokens, so Dark contrast is a token decision, never a filter. Hover and
   pressed are explicit fills (the state-layer gradient would shift the measured pair), blocked
   actions keep the shared disabled colors, and ordinary or other auth actions are untouched. */
:where(.cantos-ui)[data-expression="theatre"] .cui-surface[data-tone="primary-container"][data-variant="profile"] .cui-button-field:has(> .cui-button:where([data-variant="auth-primary"], [data-variant="auth-secondary"])) {
  display: grid;
  inline-size: 100%;
  justify-items: stretch;
}
:where(.cantos-ui)[data-expression="theatre"] .cui-surface[data-tone="primary-container"][data-variant="profile"] .cui-button:where([data-variant="auth-primary"], [data-variant="auth-secondary"]) {
  inline-size: 100%;
  min-block-size: var(--cantos-size-auth-primary);
  /* Keep the icon and a whole short action label together at 320px / 200% root text. */
  padding-inline: var(--cantos-space-xs);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-surface[data-tone="primary-container"][data-variant="profile"] .cui-button[data-variant="auth-primary"]:not(:disabled) {
  background-color: var(--cantos-color-theatre-profile-action);
  background-image: none;
  color: var(--cantos-color-theatre-on-profile-action);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-surface[data-tone="primary-container"][data-variant="profile"] .cui-button[data-variant="auth-primary"]:hover:not(:disabled) {
  background-color: var(--cantos-color-theatre-profile-action-hover);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-surface[data-tone="primary-container"][data-variant="profile"] .cui-button[data-variant="auth-primary"]:active:not(:disabled) {
  background-color: var(--cantos-color-theatre-profile-action-pressed);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-surface[data-tone="primary-container"][data-variant="profile"] .cui-button[data-variant="auth-secondary"]:not(:disabled) {
  background-color: var(--cantos-color-on-primary-container);
  color: var(--cantos-color-primary-container);
}
/* The card's container is also its inverse fill, so the focus ring reads from the fill's ink. */
:where(.cantos-ui)[data-expression="theatre"] .cui-surface[data-tone="primary-container"][data-variant="profile"] .cui-button:where([data-variant="auth-primary"], [data-variant="auth-secondary"]):focus-visible {
  outline-color: var(--cantos-color-on-primary-container);
}
/* The theme action inside an account tile is a filled circle (Dark lavender, Light plum) so it
   separates from the tile; focus is an inset ring in the control's own ink, which stays visible on
   the circle where the page focus color would not. */
:where(.cantos-ui)[data-expression="theatre"] .cui-surface[data-variant="account-group"] .cui-theme-cycle-button {
  background-color: var(--cantos-color-theatre-account-control);
  background-image: none;
  color: var(--cantos-color-theatre-on-account-control);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-surface[data-variant="account-group"] .cui-theme-cycle-button:where(:hover, :active) {
  background-color: var(--cantos-color-theatre-account-control-hover);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-surface[data-variant="account-group"] .cui-theme-cycle-button:focus-visible {
  outline-color: currentColor;
  outline-offset: calc(var(--cantos-size-focus-width) * -1);
}

/* Search v4.3: the field shell owns the header (control, label, trailing actions), fill and
   perimeter, in one fixed row. The results dock is not part of it: it is a floating layer anchored
   to the field's bottom edge (the positioning model of an overlay search, none of another
   product's look), so opening, closing or growing it never changes the header, the hero or any
   content after it. Closed, it is inert, hidden and not hit-tested. */
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-kind="search"] input::-webkit-search-cancel-button {
  -webkit-appearance: none;
  appearance: none;
}
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-kind="search"] { position: relative; }
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"] .cui-field-shell[data-docked="true"] {
  grid-template-rows: minmax(var(--cantos-size-search-header), auto);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"] .cui-field-shell[data-docked="true"] > :is(.cui-field-control, .cui-field-trailing, .cui-field-label) {
  grid-row: 1;
}
:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"][data-kind="search"] .cui-field-shell[data-docked="true"][data-expanded="true"] {
  outline: var(--cantos-size-focus-width) solid var(--cantos-color-focus);
  outline-offset: calc(-1 * var(--cantos-size-focus-width));
}
:where(.cantos-ui)[data-expression="theatre"] .cui-field > .cui-search-dock {
  position: absolute;
  inset-inline: 0;
  inset-block-start: calc(100% + var(--cantos-space-xs));
  z-index: var(--cantos-web-search-layer);
  box-sizing: border-box;
  border-radius: var(--cantos-shape-search-open);
  background: var(--cantos-color-surface-container-high);
  color: var(--cantos-color-on-surface);
  box-shadow: var(--cantos-elevation-overlay);
  overflow: hidden;
  visibility: hidden;
  pointer-events: none;
  opacity: 0;
  transform: translateY(calc(-1 * var(--cantos-web-search-travel)));
  transition: opacity var(--cantos-web-search-effects-duration) var(--cantos-motion-effects-easing),
    transform var(--cantos-web-search-close-duration) var(--cantos-web-search-close-easing),
    visibility 0s linear var(--cantos-web-search-close-duration);
}
:where(.cantos-ui)[data-expression="theatre"] .cui-field > .cui-search-dock[data-expanded="true"] {
  visibility: visible;
  pointer-events: auto;
  opacity: 1;
  transform: translateY(0);
  transition-duration: var(--cantos-web-search-effects-duration), var(--cantos-web-search-open-duration), 0s;
  transition-timing-function: var(--cantos-motion-effects-easing), var(--cantos-web-search-open-easing), linear;
  transition-delay: 0s;
}
/* Only this scroll box clamps: it keeps its own scroll, never chaining to the page. The floor keeps
   a few rows readable when the keyboard or the page edge leaves little room; the page then
   scrolls to the rest instead of the layer collapsing to a sliver. */
:where(.cantos-ui)[data-expression="theatre"] .cui-search-dock-scroll {
  box-sizing: border-box;
  max-block-size: min(28rem, max(10rem, calc(var(--cantos-web-search-available, 50dvh) - var(--cantos-space-xs) - env(safe-area-inset-bottom))));
  overflow-y: auto;
  overscroll-behavior: contain;
  /* A small even inset: rows add their own inline padding, so the consumer can line their text up
     with the prompt (`--cantos-web-field-inset`) without a second wrapper. */
  padding: var(--cantos-space-sm);
}
/* A fine pointer gets a slim, tonal thumb on a transparent track (still draggable, still a
   visible affordance); touch keeps its overlay scrollbar and forced colors its system one. */
@media (pointer: fine) {
  :where(.cantos-ui)[data-expression="theatre"] .cui-search-dock-scroll {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--cantos-color-on-surface-variant) 55%, transparent) transparent;
  }
}
@media (forced-colors: active) {
  :where(.cantos-ui)[data-expression="theatre"] .cui-field > .cui-search-dock { border: var(--cantos-size-border) solid CanvasText; }
  :where(.cantos-ui)[data-expression="theatre"] .cui-search-dock-scroll { scrollbar-color: auto; }
}

:where(.cantos-ui)[data-expression="theatre"] .cui-field[data-variant="floating"][data-kind="search"] .cui-field-shell[data-docked="true"][data-expanded="true"][data-invalid="true"] {
  outline-color: var(--cantos-color-error);
}
