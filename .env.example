# Implemented loopback development host/migration environment (no dotenv loader).
# Export these explicitly for an isolated local database; never use production data.
# Development examples only. Supply actual secrets through the deployment secret store.
CANTOS_ENV=development
CANTOS_BIND_ADDRESS=127.0.0.1:8080
DATABASE_URL=postgresql://cantos_app@127.0.0.1:5432/cantos_development
CANTOS_WEB_ORIGIN=http://127.0.0.1:8080
CANTOS_WEB_DIST=apps/web/dist
# Adaptation generation belongs to the user-controlled AI host, outside Cantos.
# Cantos exports/receives data through authenticated tools; no model configuration is consumed.
# The following storage/provider configuration remains proposed and unused.
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_PRIVATE_BUCKET=cantos-private
S3_PUBLICATION_BUCKET=cantos-publications
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
TTS_PROVIDER=
TTS_API_KEY=
# Implemented, read only by `probe-google-tts --live` (ADR 0009). Prefer a short-lived token
# exported in the shell, e.g. "$(gcloud auth print-access-token)"; never commit a value.
CANTOS_GOOGLE_TTS_ACCESS_TOKEN=
CANTOS_GOOGLE_TTS_QUOTA_PROJECT=
# Maximum reserved/actual production cost must be explicitly configured before paid calls.
PRODUCTION_COST_LIMIT_MINOR=
PRODUCTION_COST_CURRENCY=
