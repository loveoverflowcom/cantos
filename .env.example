# Development-only local host; never point verification at real data.
CANTOS_ENV=development
CANTOS_BIND_ADDRESS=127.0.0.1:8080
DATABASE_URL=postgresql://cantos_app@127.0.0.1:5432/cantos_development
CANTOS_WEB_ORIGIN=http://127.0.0.1:8080
CANTOS_WEB_DIST=apps/cantos-studio/web/dist

# Object storage for future externally submitted audio (not yet wired).
# Keep secrets on the server; AI producer plugins must use scoped API credentials and
# expiring upload grants, not the Studio user's browser cookie.
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_PRIVATE_BUCKET=cantos-private
S3_PUBLICATION_BUCKET=cantos-publications
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
