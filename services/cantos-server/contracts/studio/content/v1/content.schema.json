{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cantos.example/contracts/content/v1",
  "$defs": {
    "CatalogSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "CatalogScriptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "export_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "export_digest": {
          "type": "string",
          "pattern": "^sir-e1:sha256:[a-f0-9]{64}$"
        }
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "current_revision",
        "issues"
      ],
      "properties": {
        "code": {
          "enum": [
            "unauthenticated",
            "not_found",
            "forbidden",
            "invalid_request",
            "invalid_script",
            "evidence_unavailable",
            "stale_revision",
            "operation_reused",
            "unavailable",
            "corrupt_revision",
            "proposal_already_submitted",
            "invalid_catalog",
            "catalog_conflict",
            "stale_cursor",
            "stale_production_inputs",
            "production_blocked"
          ]
        },
        "current_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "rule"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ContentBody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "recording"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CatalogSourceRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source"
            },
            "source": {
              "$ref": "#/$defs/CatalogSourceRef"
            }
          },
          "required": [
            "kind",
            "source"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "script"
            },
            "script": {
              "$ref": "#/$defs/CatalogScriptRef"
            },
            "source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CatalogSourceRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "script"
          ]
        }
      ]
    },
    "ContentDetails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 63
        },
        "body": {
          "$ref": "#/$defs/ContentBody"
        },
        "rights_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$"
          }
        },
        "provenance_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "language",
        "body",
        "rights_refs",
        "provenance_note"
      ]
    },
    "AppendContentRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "expected_work_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "details": {
          "$ref": "#/$defs/ContentDetails"
        }
      },
      "required": [
        "operation_id",
        "id",
        "expected_revision",
        "expected_work_revision",
        "details"
      ]
    },
    "ContentRevisionResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "content_digest": {
          "type": "string",
          "pattern": "^cc-c1:sha256:[a-f0-9]{64}$"
        },
        "revision_digest": {
          "type": "string",
          "pattern": "^cc-r1:sha256:[a-f0-9]{64}$"
        },
        "recorded_by": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "recorded_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "work_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "details": {
          "$ref": "#/$defs/ContentDetails"
        }
      },
      "required": [
        "id",
        "revision",
        "content_digest",
        "revision_digest",
        "recorded_by",
        "recorded_at",
        "work_id",
        "unit_id",
        "details"
      ]
    },
    "AppendContentResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentRevisionResponse"
        },
        "work_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "content",
        "work_revision"
      ]
    },
    "ContentRevisionSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "content_digest": {
          "type": "string",
          "pattern": "^cc-c1:sha256:[a-f0-9]{64}$"
        },
        "revision_digest": {
          "type": "string",
          "pattern": "^cc-r1:sha256:[a-f0-9]{64}$"
        },
        "recorded_by": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "recorded_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "id",
        "revision",
        "content_digest",
        "revision_digest",
        "recorded_by",
        "recorded_at"
      ]
    },
    "ContentHistoryResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revisions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/ContentRevisionSummary"
          }
        },
        "next_after": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revisions",
        "next_after"
      ]
    }
  }
}
