{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cantos.example/contracts/catalog/v1",
  "title": "Cantos Studio Catalog JSON API v1",
  "$defs": {
    "WorkDetailsDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "synopsis",
        "language",
        "visibility",
        "rights_refs"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Server also enforces the 512 UTF-8 byte limit, nonblank text and no control characters."
        },
        "synopsis": {
          "type": "string",
          "maxLength": 16384,
          "description": "Server also enforces the 16384 UTF-8 byte limit and permits only newline, carriage return and tab controls."
        },
        "language": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "visibility": {
          "enum": [
            "private",
            "unlisted",
            "public"
          ]
        },
        "rights_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$"
          }
        }
      }
    },
    "CatalogSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "CatalogScriptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "export_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "export_digest": {
          "type": "string",
          "pattern": "^sir-e1:sha256:[a-f0-9]{64}$"
        }
      }
    },
    "UnitDetailsDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Server also enforces the 512 UTF-8 byte limit, nonblank text and no control characters."
        },
        "description": {
          "type": "string",
          "maxLength": 16384,
          "description": "Server also enforces the 16384 UTF-8 byte limit and permits only newline, carriage return and tab controls."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogSourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "script": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogScriptRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(sir-c1:sha256:)?[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CatalogUnitDetailsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "source",
        "script",
        "content_digest"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Server also enforces the 512 UTF-8 byte limit, nonblank text and no control characters."
        },
        "description": {
          "type": "string",
          "maxLength": 16384,
          "description": "Server also enforces the 16384 UTF-8 byte limit and permits only newline, carriage return and tab controls."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogSourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "script": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogScriptRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(sir-c1:sha256:)?[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "WorkPatchDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Server also enforces the 512 UTF-8 byte limit, nonblank text and no control characters."
        },
        "synopsis": {
          "type": "string",
          "maxLength": 16384,
          "description": "Server also enforces the 16384 UTF-8 byte limit and permits only newline, carriage return and tab controls."
        },
        "language": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "visibility": {
          "enum": [
            "private",
            "unlisted",
            "public"
          ]
        },
        "rights_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$"
          }
        }
      },
      "minProperties": 1
    },
    "UnitPatchDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Server also enforces the 512 UTF-8 byte limit, nonblank text and no control characters."
        },
        "description": {
          "type": "string",
          "maxLength": 16384,
          "description": "Server also enforces the 16384 UTF-8 byte limit and permits only newline, carriage return and tab controls."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogSourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "script": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogScriptRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(sir-c1:sha256:)?[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "minProperties": 1
    },
    "CreateWorkRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "id",
        "kind",
        "details"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "novel",
            "story",
            "podcast"
          ]
        },
        "details": {
          "$ref": "#/$defs/WorkDetailsDto"
        }
      }
    },
    "PatchWorkRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_revision",
        "details"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "details": {
          "$ref": "#/$defs/WorkPatchDto"
        }
      }
    },
    "ArchiveWorkRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_revision"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "CreateContentUnitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "id",
        "kind",
        "expected_work_revision",
        "details"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "chapter",
            "episode"
          ]
        },
        "expected_work_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "details": {
          "$ref": "#/$defs/UnitDetailsDto"
        }
      }
    },
    "PatchContentUnitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_revision",
        "expected_work_revision",
        "details"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "expected_work_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "details": {
          "$ref": "#/$defs/UnitPatchDto"
        }
      }
    },
    "ArchiveContentUnitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_revision",
        "expected_work_revision"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "expected_work_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "ReorderContentUnitsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_revision",
        "ordered"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "ordered": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    "CatalogWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "owner_id",
        "details",
        "lifecycle",
        "revision",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "novel",
            "story",
            "podcast"
          ]
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "details": {
          "$ref": "#/$defs/WorkDetailsDto"
        },
        "lifecycle": {
          "enum": [
            "draft",
            "archived"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "Unix milliseconds supplied by the authoritative transaction clock."
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "Unix milliseconds supplied by the authoritative transaction clock."
        }
      }
    },
    "CatalogContentUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "work_id",
        "kind",
        "details",
        "position",
        "lifecycle",
        "revision",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "work_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "chapter",
            "episode"
          ]
        },
        "details": {
          "$ref": "#/$defs/CatalogUnitDetailsResponse"
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "lifecycle": {
          "enum": [
            "draft",
            "archived"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "Unix milliseconds supplied by the authoritative transaction clock."
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "Unix milliseconds supplied by the authoritative transaction clock."
        }
      }
    },
    "CatalogMutationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "units"
      ],
      "properties": {
        "work": {
          "$ref": "#/$defs/CatalogWork"
        },
        "units": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/CatalogContentUnit"
          }
        }
      }
    },
    "CatalogWorkPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/CatalogWork"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^[a-f0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CatalogContentUnitPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/CatalogContentUnit"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^[a-f0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "current_revision",
        "issues"
      ],
      "properties": {
        "code": {
          "enum": [
            "unauthenticated",
            "not_found",
            "forbidden",
            "invalid_request",
            "invalid_script",
            "evidence_unavailable",
            "stale_revision",
            "operation_reused",
            "unavailable",
            "corrupt_revision",
            "proposal_already_submitted",
            "invalid_catalog",
            "catalog_conflict",
            "stale_cursor",
            "stale_production_inputs",
            "production_blocked"
          ]
        },
        "current_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "rule"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
