{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cantos.example/contracts/cover-disclosure/v1",
  "title": "Cantos Studio cover disclosure v1",
  "description": "Owner public-display decision for one exact admitted Work image (ADR 0033). JSON only. A clearance requires valid_until_ms; a revocation requires explicit null. Ownership, the image binding, replay, the strictly-future expiry and the server sequence are decided by the service, not by this schema. No asset ID, rights, provenance or storage fact is part of this message.",
  "$defs": {
    "CanonicalId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ImageAssetDigest": {
      "type": "string",
      "pattern": "^ia-r1:sha256:[a-f0-9]{64}$"
    },
    "CoverDisclosureKind": {
      "type": "string",
      "enum": ["cleared", "revoked"]
    },
    "UnixMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ValidUntil": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "RecordCoverDisclosureRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "image_asset_digest", "decision", "valid_until_ms"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/CanonicalId"},
        "image_asset_digest": {"$ref": "#/$defs/ImageAssetDigest"},
        "decision": {"$ref": "#/$defs/CoverDisclosureKind"},
        "valid_until_ms": {"anyOf": [{"$ref": "#/$defs/ValidUntil"}, {"type": "null"}]}
      },
      "oneOf": [
        {"properties": {"decision": {"const": "cleared"}, "valid_until_ms": {"$ref": "#/$defs/ValidUntil"}}},
        {"properties": {"decision": {"const": "revoked"}, "valid_until_ms": {"type": "null"}}}
      ]
    },
    "CoverDisclosureResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "sequence", "image_asset_digest", "decision", "valid_until_ms", "recorded_at_ms"],
      "properties": {
        "work_id": {"$ref": "#/$defs/CanonicalId"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "image_asset_digest": {"$ref": "#/$defs/ImageAssetDigest"},
        "decision": {"$ref": "#/$defs/CoverDisclosureKind"},
        "valid_until_ms": {"anyOf": [{"$ref": "#/$defs/ValidUntil"}, {"type": "null"}]},
        "recorded_at_ms": {"$ref": "#/$defs/UnixMillis"}
      },
      "oneOf": [
        {"properties": {"decision": {"const": "cleared"}, "valid_until_ms": {"$ref": "#/$defs/ValidUntil"}}},
        {"properties": {"decision": {"const": "revoked"}, "valid_until_ms": {"type": "null"}}}
      ]
    }
  }
}
