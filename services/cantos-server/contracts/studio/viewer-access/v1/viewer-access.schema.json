{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ViewerAccessChange": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "set_audience"
            },
            "audience": {
              "enum": [
                "public",
                "restricted"
              ]
            },
            "confirm_metadata_rights": {
              "type": "boolean"
            }
          },
          "required": [
            "action",
            "audience",
            "confirm_metadata_rights"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "grant_actor"
            },
            "grant_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,64}$"
            },
            "expires_at_us": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "action",
            "grant_id",
            "actor_id",
            "expires_at_us"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "grant_group"
            },
            "grant_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "group_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "expires_at_us": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "action",
            "grant_id",
            "group_id",
            "expires_at_us"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "revoke_grant"
            },
            "grant_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            }
          },
          "required": [
            "action",
            "grant_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "share_mailbox"
            },
            "share_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "email": {
              "type": "string",
              "minLength": 1,
              "maxLength": 254
            }
          },
          "required": [
            "action",
            "share_id",
            "email"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "revoke_share"
            },
            "share_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            }
          },
          "required": [
            "action",
            "share_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "set_unit_policy"
            },
            "unit_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "policy": {
              "$ref": "#/$defs/UnitViewerPolicy"
            },
            "confirm_metadata_rights": {
              "type": "boolean"
            }
          },
          "required": [
            "action",
            "unit_id",
            "policy",
            "confirm_metadata_rights"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ViewerAccessRequest": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "change": {
          "$ref": "#/$defs/ViewerAccessChange"
        }
      },
      "required": [
        "operation_id",
        "expected_version",
        "change"
      ],
      "additionalProperties": false
    },
    "ViewerAccessReceipt": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "work_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "operation_id",
        "work_id",
        "version",
        "replayed"
      ],
      "additionalProperties": false
    },
    "ViewerGroupChange": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "create"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "action",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "add_member"
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,64}$"
            },
            "expires_at_us": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "action",
            "actor_id",
            "expires_at_us"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "remove_member"
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,64}$"
            }
          },
          "required": [
            "action",
            "actor_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "revoke"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ViewerGroupRequest": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "change": {
          "$ref": "#/$defs/ViewerGroupChange"
        }
      },
      "required": [
        "operation_id",
        "expected_version",
        "change"
      ],
      "additionalProperties": false
    },
    "ViewerGroupReceipt": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "group_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "operation_id",
        "group_id",
        "version",
        "replayed"
      ],
      "additionalProperties": false
    },
    "ViewerPrincipal": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "actor"
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,64}$"
            }
          },
          "required": [
            "kind",
            "actor_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "group"
            },
            "group_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            }
          },
          "required": [
            "kind",
            "group_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ViewerGrant": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "principal": {
          "$ref": "#/$defs/ViewerPrincipal"
        },
        "expires_at_us": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "grant_id",
        "principal",
        "expires_at_us"
      ],
      "additionalProperties": false
    },
    "PendingViewerShare": {
      "type": "object",
      "properties": {
        "share_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        },
        "expires_at_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "share_id",
        "email",
        "expires_at_us"
      ],
      "additionalProperties": false
    },
    "ViewerGroupMember": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "expires_at_us": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actor_id",
        "expires_at_us"
      ],
      "additionalProperties": false
    },
    "ViewerAccessState": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "audience": {
          "enum": [
            "public",
            "restricted"
          ]
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewerGrant"
          },
          "maxItems": 1000
        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingViewerShare"
          },
          "maxItems": 100
        }
      },
      "required": [
        "work_id",
        "version",
        "audience",
        "grants",
        "pending"
      ],
      "additionalProperties": false
    },
    "ViewerGroupState": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "revoked": {
          "type": "boolean"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewerGroupMember"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "group_id",
        "name",
        "version",
        "revoked",
        "members"
      ],
      "additionalProperties": false
    },
    "ViewerGroups": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewerGroupState"
          },
          "maxItems": 100
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "UnitViewerGrant": {
      "type": "object",
      "properties": {
        "principal": {
          "$ref": "#/$defs/ViewerPrincipal"
        },
        "expires_at_us": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "principal",
        "expires_at_us"
      ],
      "additionalProperties": false
    },
    "UnitViewerPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "inherit"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "restricted"
            },
            "grants": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/UnitViewerGrant"
              }
            }
          },
          "required": [
            "mode",
            "grants"
          ],
          "additionalProperties": false
        }
      ]
    },
    "UnitViewerAccessState": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "policy": {
          "$ref": "#/$defs/UnitViewerPolicy"
        }
      },
      "required": [
        "work_id",
        "unit_id",
        "version",
        "policy"
      ],
      "additionalProperties": false
    },
    "MatrixAudio": {
      "type": "object",
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "release_digest": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "exact",
            "display_only"
          ]
        }
      },
      "required": [
        "release_id",
        "release_digest",
        "basis"
      ],
      "additionalProperties": false
    },
    "ChapterMatrixRow": {
      "type": "object",
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "title": {
          "type": "string"
        },
        "draft_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "published_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "published_position": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/MatrixAudio"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "$ref": "#/$defs/UnitViewerPolicy"
        }
      },
      "required": [
        "unit_id",
        "title",
        "draft_revision",
        "published_revision",
        "published_position",
        "audio",
        "policy"
      ],
      "additionalProperties": false
    },
    "ChapterMatrixPage": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "work_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "publication_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "policy_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "work_audience": {
          "enum": [
            "public",
            "restricted"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/ChapterMatrixRow"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_lifecycle": {
          "enum": [
            "never_published",
            "active",
            "withdrawn"
          ]
        }
      },
      "required": [
        "work_id",
        "work_revision",
        "publication_version",
        "policy_version",
        "work_audience",
        "items",
        "next_cursor",
        "publication_lifecycle"
      ],
      "additionalProperties": false
    }
  }
}
