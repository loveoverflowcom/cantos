{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cantos.example/contracts/theatre/discovery/metadata.schema.json",
  "title": "Opt-in sample metadata Discovery",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"},
    "cursor": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^lc1_[a-f0-9]{64}$"}]},
    "safe": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "cover": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "sha256", "content_type", "width_px", "height_px", "byte_length", "alt_text"],
      "properties": {
        "url": {"type": "string", "maxLength": 4096}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "content_type": {"enum": ["image/png", "image/jpeg", "image/avif"]},
        "width_px": {"type": "integer", "minimum": 1, "maximum": 4096},
        "height_px": {"type": "integer", "minimum": 1, "maximum": 4096},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "alt_text": {"type": "string", "maxLength": 1024}
      }
    },
    "work": {
      "type": "object", "additionalProperties": false,
      "required": ["work_id", "kind", "title", "description", "language", "first_visible_at_ms", "unit_count", "cover"],
      "properties": {
        "work_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["novel", "story", "podcast"]},
        "title": {"type": "string", "maxLength": 512}, "description": {"type": "string", "maxLength": 16384},
        "language": {"type": "string", "maxLength": 63}, "first_visible_at_ms": {"$ref": "#/$defs/safe"},
        "unit_count": {"$ref": "#/$defs/safe"}, "cover": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/cover"}]}
      }
    },
    "works": {"type": "object", "additionalProperties": false, "required": ["items", "next_cursor"], "properties": {"items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/work"}}, "next_cursor": {"$ref": "#/$defs/cursor"}}},
    "playback": {"type": "object", "additionalProperties": false, "required": ["publication_id", "published_at_ms", "duration_ms"], "properties": {"publication_id": {"$ref": "#/$defs/id"}, "published_at_ms": {"$ref": "#/$defs/safe"}, "duration_ms": {"$ref": "#/$defs/positive"}}},
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "kind", "position", "title", "description", "ordinal", "playback"],
      "properties": {"unit_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["chapter", "episode"]},
        "position": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "title": {"type": "string", "maxLength": 512},
        "description": {"type": "string", "maxLength": 16384}, "ordinal": {"$ref": "#/$defs/positive"},
        "playback": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/playback"}]}}
    },
    "units": {"type": "object", "additionalProperties": false, "required": ["work_id", "items", "next_cursor"], "properties": {"work_id": {"$ref": "#/$defs/id"}, "items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/unit"}}, "next_cursor": {"$ref": "#/$defs/cursor"}}}
  }
}
