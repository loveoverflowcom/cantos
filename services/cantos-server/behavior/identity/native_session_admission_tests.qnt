module native_session_admission_tests {
  import native_session_admission.* from "./native_session_admission"
  action check(predicate: bool): bool = all { assert(predicate), state' = state, before' = state, last' = Assertion, outcome' = NoOutcome }
  pure val base: Identity = { read: Answer, present: true, active: true, epoch: 1, version: 1 }
  pure def fact(purpose: Purpose, epoch: int, version: int): Fact =
    { subject: 1, purpose: purpose, echoed: true, age: Fresh, epoch: epoch, version: version }
  pure val theatre: Fact = fact(Theatre, 1, 1)

  run issueTest = init.then(admit).then(check(outcome == Rejected(NoSession) and state == before))
    .then(login(Theatre, theatre)).then(check(outcome == Transition(Issued) and issueNeedsFreshBoundFact
      and state.session.observed == { subject: 1, epoch: 1, version: 1 } and state.session.purpose == Theatre))
    .then(admit).then(check(admitted and admitOnlyExactActive and state == before))
  run factBindingTest = init.then(login(Theatre, { ...theatre, echoed: false }))
    .then(check(outcome == Rejected(FactMisbound) and state == before))
    .then(login(Theatre, fact(Studio, 1, 1))).then(check(outcome == Rejected(FactMisbound)))
    .then(login(Theatre, { ...theatre, age: Stale })).then(check(staleFactRefused and state == before))
    .then(login(Theatre, { ...theatre, age: Future })).then(check(outcome == Rejected(FactNotFresh)))
    .then(login(Theatre, fact(Theatre, 1, 2))).then(check(outcome == Rejected(VersionMismatch)))
    .then(setIdentity({ ...base, version: 2 })).then(login(Theatre, theatre))
    .then(check(outcome == Rejected(VersionMismatch) and sessionChangesOnlyByTransition)).then(setIdentity(base))
    .then(login(Theatre, fact(Theatre, 2, 1))).then(check(outcome == Rejected(EpochMismatch)))
    .then(login(Theatre, { ...theatre, subject: 2 })).then(check(outcome == Rejected(SubjectUnknown)))
    .then(setIdentity({ ...base, active: false })).then(login(Theatre, theatre))
    .then(check(outcome == Rejected(Inactive) and not(state.session.exists)))
    .then(setIdentity(base)).then(setRoster(false)).then(login(Studio, fact(Studio, 1, 1)))
    .then(check(outcome == Rejected(NotOnRoster) and not(state.session.exists)))
    .then(setRoster(true)).then(login(Studio, fact(Studio, 1, 1)))
    .then(check(issued and issueNeedsFreshBoundFact and state.session.generation == 1))
    .then(admit).then(check(admitted and admitOnlyExactActive))
  run versionAdvancedTest = init.then(login(Theatre, theatre)).then(setIdentity({ ...base, version: 2 })).then(admit)
    .then(check(outcome == Rejected(SecurityChanged) and state.pending == Requested(VersionAdvanced)
      and not(state.session.revoked) and requestIsNotCommit and mismatchRequestsRevoke))
    .then(commitRevoke(true)).then(check(outcome == Transition(Revoked) and state.session.revoked and requestIsNotCommit))
    .then(setIdentity(base)).then(admit).then(check(stickyAfterRestore and revocationSticky))
    .then(commitRevoke(true)).then(check(outcome == Rejected(NothingRequested) and state == before))
  run versionRegressedTest = init.then(setIdentity({ ...base, version: 2 })).then(login(Theatre, fact(Theatre, 1, 2)))
    .then(setIdentity(base)).then(admit)
    .then(check(regressionRequested and mismatchRequestsRevoke and not(state.session.revoked)))
    .then(commitRevoke(true)).then(setIdentity({ ...base, version: 2 })).then(admit)
    .then(check(stickyAfterRestore and revocationSticky))
  run securityChangesTest = init.then(login(Theatre, theatre)).then(setIdentity({ ...base, epoch: 2 })).then(admit)
    .then(check(epochChangeRequested and mismatchRequestsRevoke))
    .then(commitRevoke(true)).then(setIdentity(base)).then(admit).then(check(stickyAfterRestore))
    .then(login(Theatre, theatre)).then(check(outcome == Transition(Issued) and state.session.generation == 2))
    .then(setIdentity({ ...base, active: false })).then(admit)
    .then(check(state.pending == Requested(Disabled) and mismatchRequestsRevoke))
    .then(commitRevoke(true)).then(setIdentity(base)).then(admit).then(check(stickyAfterRestore))
    .then(login(Theatre, theatre)).then(setIdentity({ ...base, present: false })).then(admit)
    .then(check(state.pending == Requested(SubjectMissing) and mismatchRequestsRevoke))
    .then(commitRevoke(true)).then(setIdentity(base)).then(admit).then(check(stickyAfterRestore and revocationSticky))
  run outageTest = init.then(login(Theatre, theatre)).then(setIdentity({ ...base, read: Unreachable })).then(admit)
    .then(check(outageDenied and outageNeverRevokes and state.pending == NoPending))
    .then(login(Theatre, theatre))
    .then(check(outcome == Rejected(IdentityUnavailable) and outageNeverRevokes and state.session.generation == 1))
    .then(setIdentity({ ...base, read: Malformed })).then(admit)
    .then(check(outageDenied and outageNeverRevokes and state.pending == NoPending))
    .then(setIdentity(base)).then(admit).then(check(admitted))
    .then(setIdentity({ ...base, read: Unreachable })).then(logout)
    .then(check(outcome == Transition(LoggedOut) and state.session.revoked))
    .then(setIdentity(base)).then(admit).then(check(outcome == Rejected(SessionRevoked)))
  run failedRevokeWriteTest = init.then(login(Theatre, theatre)).then(setIdentity({ ...base, active: false }))
    .then(admit).then(commitRevoke(false))
    .then(check(requestWithoutCommit and state.pending == NoPending and requestIsNotCommit
      and sessionChangesOnlyByTransition))
    .then(admit).then(check(outcome == Rejected(SecurityChanged) and state.pending == Requested(Disabled)))
    .then(commitRevoke(true)).then(check(outcome == Transition(Revoked) and state.session.revoked))
    .then(setIdentity({ ...base, version: 2 })).then(login(Theatre, fact(Theatre, 1, 2)))
    .then(setIdentity({ ...base, version: 2, active: false })).then(admit)
    .then(check(state.pending == Requested(Disabled))).then(logout).then(commitRevoke(true))
    .then(check(outcome == NoOp(AlreadyEnded) and state.session == before.session and state.pending == NoPending))
  run studioRosterTest = init.then(login(Studio, fact(Studio, 1, 1))).then(setRoster(false)).then(admit)
    .then(check(outcome == Rejected(NotOnRoster)))
    .then(login(Theatre, theatre)).then(admit)
    .then(check(admitted and state.session.purpose == Theatre and not(state.rostered)))
}
