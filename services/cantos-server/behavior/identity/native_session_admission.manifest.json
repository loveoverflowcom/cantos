  "controls": [
    {
      "id": "cantos.identity.native-session-admission.control.issue-needs-fresh-bound-fact",
      "property": "cantos.identity.native-session-admission.property.issue-needs-fresh-bound-fact",
      "from": "else if (fact.age != Fresh) record(state, event, Rejected(FactNotFresh))",
      "to": "else if (false) record(state, event, Rejected(FactNotFresh))"
    },
    {
      "id": "cantos.identity.native-session-admission.control.admit-only-exact-active",
      "property": "cantos.identity.native-session-admission.property.admit-only-exact-active",
      "from": "else if (id.version < observed.version) request(VersionRegressed)",
      "to": "else if (false) request(VersionRegressed)"
    },
    {
      "id": "cantos.identity.native-session-admission.control.mismatch-requests-revoke",
      "property": "cantos.identity.native-session-admission.property.mismatch-requests-revoke",
      "from": "else if (not(id.active)) request(Disabled)",
      "to": "else if (not(id.active)) record(state, Admit, Rejected(Inactive))"
    },
    {
      "id": "cantos.identity.native-session-admission.control.request-is-not-commit",
      "property": "cantos.identity.native-session-admission.property.request-is-not-commit",
      "from": "record({ ...state, pending: Requested(reason) }, Admit, Rejected(SecurityChanged))",
      "to": "record({ ...state, pending: Requested(reason), session: { ...state.session, revoked: true } }, Admit, Rejected(SecurityChanged))"
    },
    {
      "id": "cantos.identity.native-session-admission.control.revocation-sticky",
      "property": "cantos.identity.native-session-admission.property.revocation-sticky",
      "from": "else if (state.session.revoked) record(state, Admit, Rejected(SessionRevoked))",
      "to": "else if (false) record(state, Admit, Rejected(SessionRevoked))"
    },
    {
      "id": "cantos.identity.native-session-admission.control.outage-never-revokes",
      "property": "cantos.identity.native-session-admission.property.outage-never-revokes",
      "from": "else if (state.identity.read != Answer) record(state, Admit, Rejected(IdentityUnavailable))",
      "to": "else if (state.identity.read != Answer) request(SubjectMissing)"
    },
    {
      "id": "cantos.identity.native-session-admission.control.session-changes-only-by-transition",
      "property": "cantos.identity.native-session-admission.property.session-changes-only-by-transition",
      "from": "else record({ ...state, pending: NoPending }, CommitRevoke(written), Rejected(RevokeWriteFailed))",
      "to": "else record({ ...state, pending: NoPending, session: { ...state.session, revoked: true } }, CommitRevoke(written), Rejected(RevokeWriteFailed))"
    }
  ],
