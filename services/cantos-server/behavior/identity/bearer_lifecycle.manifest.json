  "controls": [
    {
      "id": "cantos.identity.bearer-lifecycle.control.revocation-sticky",
      "property": "cantos.identity.bearer-lifecycle.property.revocation-sticky",
      "from": "state.revoked or not(state.unexpired)",
      "to": "not(state.unexpired)"
    },
    {
      "id": "cantos.identity.bearer-lifecycle.control.single-use",
      "property": "cantos.identity.bearer-lifecycle.property.single-use",
      "from": "record({ ...state, revoked: true }, Refresh(presented), ReuseRevoked)",
      "to": "record(state, Refresh(presented), ReuseRevoked)"
    },
    {
      "id": "cantos.identity.bearer-lifecycle.control.bounded-authority",
      "property": "cantos.identity.bearer-lifecycle.property.bounded-authority",
      "from": "generation: state.generation + 1",
      "to": "generation: state.generation + 1, absolute: state.absolute + 1"
    },
    {
      "id": "cantos.identity.bearer-lifecycle.control.auth-time-unchanged",
      "property": "cantos.identity.bearer-lifecycle.property.auth-time-unchanged",
      "from": "generation: state.generation + 1",
      "to": "generation: state.generation + 1, authTime: state.authTime + 1"
    },
    {
      "id": "cantos.identity.bearer-lifecycle.control.native-journal-before-refresh",
      "property": "cantos.identity.bearer-lifecycle.property.native-journal-before-refresh",
      "from": "journal: NativeRefreshing, barrier: true,\n        inFlight: true, calls: native.calls + 1",
      "to": "journal: NativeActive, barrier: true,\n        inFlight: true, calls: native.calls + 1"
    },
    {
      "id": "cantos.identity.bearer-lifecycle.control.native-single-flight",
      "property": "cantos.identity.bearer-lifecycle.property.native-single-flight",
      "from": "if (native.inFlight) nativeRecord(native, NativeStart(written), JoinedFlight)",
      "to": "if (false) nativeRecord(native, NativeStart(written), JoinedFlight)"
    },
    {
      "id": "cantos.identity.bearer-lifecycle.control.native-unknown-cleanup-only",
      "property": "cantos.identity.bearer-lifecycle.property.native-unknown-cleanup-only",
      "from": "cleanup: true, barrier: true }, event, UnknownRefresh)",
      "to": "cleanup: true, barrier: true, calls: native.calls + 1 }, event, UnknownRefresh)"
    },
    {
      "id": "cantos.identity.bearer-lifecycle.control.native-persist-before-admission",
      "property": "cantos.identity.bearer-lifecycle.property.native-persist-before-admission",
      "from": "nativeRecord({ ...native, admitted: false, cleanup: true, barrier: true,\n        pendingPair: false }, NativePersist(written), PairRefused)",
      "to": "nativeRecord({ ...native, admitted: true, cleanup: true, barrier: true,\n        pendingPair: false }, NativePersist(written), PairRefused)"
    },
    {
      "id": "cantos.identity.bearer-lifecycle.control.native-restart-needs-confirmation",
      "property": "cantos.identity.bearer-lifecycle.property.native-restart-needs-confirmation",
      "from": "intent: intent, admitted: false, inFlight: false, pendingPair: false,",
      "to": "intent: intent, admitted: true, inFlight: false, pendingPair: false,"
    },
    {
      "id": "cantos.identity.bearer-lifecycle.control.native-late-result-fenced",
      "property": "cantos.identity.bearer-lifecycle.property.native-late-result-fenced",
      "from": "actor == native.actor and intent == native.intent",
      "to": "true"
    },
    {
      "id": "cantos.identity.bearer-lifecycle.control.native-marker-before-barrier-clear",
      "property": "cantos.identity.bearer-lifecycle.property.native-marker-before-barrier-clear",
      "from": "if (native.cleanup and native.journal == NativeCleared)",
      "to": "if (native.cleanup)"
    }
  ],
