# Narrow LOCAL EVALUATION config for the pinned Kanidm 1.10.5 image.
# Copy outside Git; supply operator-owned TLS, never generated automatically by xtask.
# Mount private config/TLS read-only at /config; keep identity data on the named /data volume.
version = "2"
bindaddress = "[::]:8443"
db_path = "/data/kanidm.db"
tls_chain = "/config/chain.pem"
tls_key = "/config/key.pem"
domain = "idm.cantos.localhost"
# Match the chosen HOST port; internal TLS health uses localhost:8443.
origin = "https://idm.cantos.localhost:8443"
