  "controls": [
    {
      "id": "cantos.production.forge-attempt.control.calls-never-exceed-reservations",
      "property": "cantos.production.forge-attempt.property.calls-never-exceed-reservations",
      "from": "state.phase == Open, not(state.dispatched),",
      "to": "state.phase == Open,"
    },
    {
      "id": "cantos.production.forge-attempt.control.spend-is-bounded",
      "property": "cantos.production.forge-attempt.property.spend-is-bounded",
      "from": "decided(presented), state.attempts < maxAttempts, state.spent + cost <= budget,",
      "to": "decided(presented), state.attempts < maxAttempts,"
    },
    {
      "id": "cantos.production.forge-attempt.control.no-retry-while-open",
      "property": "cantos.production.forge-attempt.property.no-retry-while-open",
      "from": "state.phase != Open and (state.phase != Uncertain or presented == state.attempts)",
      "to": "(state.phase != Uncertain or presented == state.attempts)"
    },
    {
      "id": "cantos.production.forge-attempt.control.uncertainty-needs-acknowledgement",
      "property": "cantos.production.forge-attempt.property.uncertainty-needs-acknowledgement",
      "from": "(state.phase != Uncertain or presented == state.attempts)",
      "to": "(state.phase != Uncertain or presented != 0)"
    },
    {
      "id": "cantos.production.forge-attempt.control.replay-and-refusal-change-nothing",
      "property": "cantos.production.forge-attempt.property.replay-and-refusal-change-nothing",
      "from": "record(state, Submit, Replayed, 0)",
      "to": "record({ ...state, attempts: state.attempts + 1 }, Submit, Replayed, 0)"
    },
    {
      "id": "cantos.production.forge-attempt.control.request-is-immutable",
      "property": "cantos.production.forge-attempt.property.request-is-immutable",
      "from": "record(state, Submit, Conflicted, 0)",
      "to": "record({ ...state, request: request }, Submit, Conflicted, 0)"
    },
    {
      "id": "cantos.production.forge-attempt.control.results-are-kept",
      "property": "cantos.production.forge-attempt.property.results-are-kept",
      "from": "phase: Open, attempts: state.attempts + 1,",
      "to": "phase: Open, successes: 0, attempts: state.attempts + 1,"
    }
