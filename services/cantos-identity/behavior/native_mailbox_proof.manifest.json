      "id": "cantos.identity.native-mailbox-proof.control.terminal-sticky",
      "property": "cantos.identity.native-mailbox-proof.property.terminal-sticky",
      "from": "else if (current.state == Cancelled) record(state, event, Rejected(AlreadyCancelled))",
      "to": "else if (false) record(state, event, Rejected(AlreadyCancelled))"
    },
    {
      "id": "cantos.identity.native-mailbox-proof.control.retired-locator-rejected",
      "property": "cantos.identity.native-mailbox-proof.property.retired-locator-rejected",
      "from": "else if (p.loc != d.proof.loc) record(state, event, Rejected(ProofChanged))",
      "to": "else if (false) record(state, event, Rejected(ProofChanged))"
    },
    {
      "id": "cantos.identity.native-mailbox-proof.control.plan-has-no-effect",
      "property": "cantos.identity.native-mailbox-proof.property.plan-has-no-effect",
      "from": "else record({ ...state, plan: Planned({",
      "to": "else record({ ...state, durable: { ...d, proof: { ...d.proof, state: Consumed } }, plan: Planned({"
    },
    {
      "id": "cantos.identity.native-mailbox-proof.control.commit-compares-snapshot",
      "property": "cantos.identity.native-mailbox-proof.property.commit-compares-snapshot",
      "from": "if (plan.expected != d.proof) record(cleared, event, Rejected(StaleSnapshot))",
      "to": "if (false) record(cleared, event, Rejected(StaleSnapshot))"
    },
    {
      "id": "cantos.identity.native-mailbox-proof.control.single-account-effect",
      "property": "cantos.identity.native-mailbox-proof.property.single-account-effect",
      "from": "else if (d.proof.state == Consumed) record(state, event, Rejected(AlreadyConsumed))",
      "to": "else if (false) record(state, event, Rejected(AlreadyConsumed))"
    },
    {
      "id": "cantos.identity.native-mailbox-proof.control.no-authority",
      "property": "cantos.identity.native-mailbox-proof.property.no-authority",
      "from": "receipts: d.receipts.put(plan.command, plan.request), accounts: d.accounts + 1 } }",
      "to": "receipts: d.receipts.put(plan.command, plan.request), accounts: d.accounts + 1 }, session: true }"
    },
    {
      "id": "cantos.identity.native-mailbox-proof.control.only-committed-effects",
      "property": "cantos.identity.native-mailbox-proof.property.only-committed-effects",
      "from": "else if (fate == UnknownLost) record(cleared, event, UnknownEffect)",
      "to": "else if (fate == UnknownLost) record(applied, event, UnknownEffect)"
    }
