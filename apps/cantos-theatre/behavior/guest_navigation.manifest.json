      "id": "cantos.presentation.guest-navigation.control.auth-return",
      "property": "cantos.presentation.guest-navigation.property.auth-return",
      "from": "val target = if (state.origin == Landing) Discover else state.origin",
      "to": "val target = Discover"
    },
    {
      "id": "cantos.presentation.guest-navigation.control.stale-ignored",
      "property": "cantos.presentation.guest-navigation.property.stale-ignored",
      "from": "else record(state, Complete(ticket))",
      "to": "else record({ ...state, route: Discover }, Complete(ticket))"
    },
    {
      "id": "cantos.presentation.guest-navigation.control.idempotent-navigation",
      "property": "cantos.presentation.guest-navigation.property.idempotent-navigation",
      "from": "pushes: state.pushes + (if (route == state.route) 0 else 1)",
      "to": "pushes: state.pushes + 1"
    },
    {
      "id": "cantos.presentation.guest-navigation.control.public-owners-survive",
      "property": "cantos.presentation.guest-navigation.property.public-owners-survive",
      "from": "phase: LogoutPending, nav: false, pending: 0, origin: Discover",
      "to": "phase: LogoutPending, nav: false, pending: 0, origin: Discover, publicPlays: 0"
    },
    {
      "id": "cantos.presentation.guest-navigation.control.return-intent",
      "property": "cantos.presentation.guest-navigation.property.return-intent",
      "from": "else if (route == state.route) state.origin else returnDestination(route)",
      "to": "else if (route == state.route) Discover else returnDestination(route)"
    }
