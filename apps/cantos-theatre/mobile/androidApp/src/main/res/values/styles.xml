<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cantos" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cantos_launch_background</item>
        <item name="android:statusBarColor">@color/cantos_launch_background</item>
        <item name="android:navigationBarColor">@color/cantos_launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Cantos.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cantos_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/cantos_splash_symbol</item>
        <item name="postSplashScreenTheme">@style/Theme.Cantos</item>
    </style>
</resources>
