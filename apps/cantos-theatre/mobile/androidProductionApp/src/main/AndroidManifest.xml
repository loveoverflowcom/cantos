<?xml version="1.0" encoding="utf-8"?>
<!-- Production catalog host: anonymous network reads, explicit origin and HTTPS-only release.
     Debug adds only its loopback cleartext policy. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application
        android:allowBackup="false"
        android:label="Cantos"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Cantos">
        <meta-data android:name="CantosApiOrigin" android:value="${cantosApiOrigin}" />
        <meta-data android:name="CantosNativeIssuer" android:value="${cantosNativeIssuer}" />
        <service
            android:name="com.cantos.theatre.adapters.playback.CantosPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name=".app.TheatreActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.cantos.theatre" />
            </intent-filter>
        </activity>
    </application>
</manifest>
