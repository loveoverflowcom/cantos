<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only cleartext override, limited to loopback (127.0.0.1 / localhost,
     e.g. `adb reverse tcp:8080 tcp:8080`). Android 6 (API 23) ignores networkSecurityConfig, so loopback http there stays
     blocked by usesCleartextTraffic=false; use API 24+ or an https origin. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/cantos_loopback_network_security" />
</manifest>
